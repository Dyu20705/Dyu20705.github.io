---
import ProfileShell from '../layouts/ProfileShell.astro';
import { galleryItems } from '../data/site';
---

<ProfileShell
	headTitle="Thư viện | Nguyễn Văn Duy"
	description="Bộ sưu tập hình ảnh cá nhân của Nguyễn Văn Duy."
	activeNav="gallery"
>
	<section>
		<h2 class="page-title" data-i18n="page.gallery.title">Thư viện</h2>
		<div class="page-accent"></div>
	</section>

	<section class="gallery-grid">
		{galleryItems.map((item, index) => (
			<article class="gallery-card">
				<img src={item.image.src} alt={item.title} loading="lazy" />
				<div class="gallery-copy">
					<h3 data-i18n={`gallery.item.${index}.title`}>{item.title}</h3>
					<p data-i18n={`gallery.item.${index}.caption`}>{item.caption}</p>
				</div>
			</article>
		))}
	</section>

	<style>
		.page-title {
			font-size: clamp(2.2rem, 4vw, 3.4rem);
		}

		.page-accent {
			width: 58px;
			height: 4px;
			margin-top: 0.9rem;
			border-radius: 999px;
			background: #17b8ff;
		}

		.gallery-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 1.5rem;
		}

		.gallery-card {
			overflow: hidden;
			border-radius: 1.2rem;
			border: 1px solid rgba(216, 190, 154, 0.35);
			background: rgba(255, 255, 255, 0.03);
		}

		.gallery-card img {
			width: 100%;
			height: 240px;
			object-fit: cover;
			border-radius: 0;
		}

		.gallery-copy {
			padding: 0.95rem;
		}

		.gallery-copy h3 {
			font-size: 1.2rem;
			margin-bottom: 0.35rem;
		}

		.gallery-copy p {
			color: #b8c5d2;
		}

		@media (max-width: 980px) {
			.gallery-grid {
				grid-template-columns: 1fr 1fr;
			}
		}

		@media (max-width: 720px) {
			.gallery-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</ProfileShell>
