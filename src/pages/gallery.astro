---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Copy from '../components/Copy.astro';
import { galleryItems } from '../data/site';
---
<SiteLayout activeNav="gallery" title={{vi:'Ảnh | Nguyễn Văn Duy',en:'Gallery | Nguyễn Văn Duy'}} description={{vi:'Một số hình ảnh trong bộ sưu tập cá nhân của Nguyễn Văn Duy.',en:'Photographs from Nguyễn Văn Duy’s personal collection.'}}>
  <div class="page-intro"><p class="eyebrow"><Copy vi="Bộ sưu tập cá nhân" en="Personal collection" /></p><h1><Copy vi="Ảnh" en="Gallery" /></h1></div>
  <div class="gallery-grid">{galleryItems.map(item => <Image src={item.image} alt={item.alt.vi} data-alt-vi={item.alt.vi} data-alt-en={item.alt.en} width={960} widths={[360,640,960]} sizes="(max-width:767px) calc(100vw - 32px), (max-width:1199px) 45vw, 30vw" format="webp" loading="lazy" />)}</div>
</SiteLayout>
<style>
 .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: start; }
 .gallery-grid img { width: 100%; height: auto; border-radius: 4px; }
 @media(min-width:768px) and (max-width:1199px) { .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
 @media(max-width:767px) { .gallery-grid { grid-template-columns: 1fr; gap: 20px; } }
</style>
