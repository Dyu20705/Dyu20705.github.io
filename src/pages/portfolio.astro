---
import PortfolioPage from '../components/projects/PortfolioPage.astro';
import { publishedProjects, PROJECTS_PER_PAGE } from '../data/content';
const projects = await publishedProjects();
---
<PortfolioPage projects={projects.slice(0, PROJECTS_PER_PAGE)} pages={Math.ceil(projects.length / PROJECTS_PER_PAGE)} />
