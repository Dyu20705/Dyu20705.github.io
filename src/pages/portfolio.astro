---
import { Image } from 'astro:assets';
import ProfileShell from '../layouts/ProfileShell.astro';
import { portfolioProjects } from '../data/site';
---

<ProfileShell
	headTitle="Dự án | Nguyễn Văn Duy"
	description="Các dự án cá nhân liên quan đến systems thinking, automation, backend, workflow và nền tảng cho định hướng MLOps."
	activeNav="portfolio"
>
	<section>
		<h2 class="page-title" data-i18n="page.portfolio.title">Dự án</h2>
		<div class="page-accent"></div>
	</section>

	<section class="portfolio-filters" aria-label="Portfolio filters">
		<button class="filter-button is-active" type="button" data-filter="all" data-i18n="portfolio.filter.all">All</button>
		<button class="filter-button" type="button" data-filter="systems" data-i18n="portfolio.filter.systems">Systems</button>
		<button class="filter-button" type="button" data-filter="app" data-i18n="portfolio.filter.app">App</button>
		<button class="filter-button" type="button" data-filter="tools" data-i18n="portfolio.filter.tools">Tools</button>
	</section>

	<section class="portfolio-grid" id="portfolio-grid">
		{portfolioProjects.map((project, index) => (
			<a
				class="portfolio-card"
				href={project.url}
				target="_blank"
				rel="noopener noreferrer"
				data-category={project.category}
			>
				<div class="architecture-preview" aria-hidden="true">
					<Image src={project.image} alt={project.title} loading="lazy" decoding="async" sizes="(max-width: 900px) 100vw, 33vw" />
					<svg viewBox="0 0 320 150" fill="none">
						<path d="M34 78h72c26 0 30-42 58-42h122" />
						<path d="M34 104h86c23 0 34 25 58 25h108" />
						<circle cx="34" cy="78" r="7" />
						<circle cx="164" cy="36" r="7" />
						<circle cx="286" cy="36" r="7" />
						<circle cx="286" cy="129" r="7" />
						<circle cx="34" cy="104" r="7" />
					</svg>
				</div>
				<div class="portfolio-copy">
					<dl class="dossier-meta">
						<div><dt data-i18n="portfolio.meta.project">PROJECT</dt><dd>{project.title}</dd></div>
						<div><dt data-i18n="portfolio.meta.type">TYPE</dt><dd data-i18n={`portfolio.project.${index}.status`}>{project.status}</dd></div>
						<div><dt data-i18n="portfolio.meta.domain">DOMAIN</dt><dd data-i18n={`portfolio.project.${index}.label`}>{project.label}</dd></div>
					</dl>
					<div class="portfolio-top">
						<h3>{project.title}</h3>
						<span class="portfolio-tag" data-i18n={`portfolio.project.${index}.label`}>{project.label}</span>
					</div>
					<p data-i18n={`portfolio.project.${index}.description`}>{project.description}</p>
					<dl class="project-facts">
						<div>
							<dt data-i18n="portfolio.problem">Vấn đề</dt>
							<dd data-i18n={`portfolio.project.${index}.problem`}>{project.problem}</dd>
						</div>
						<div>
							<dt data-i18n="portfolio.role">Vai trò</dt>
							<dd data-i18n={`portfolio.project.${index}.role`}>{project.role}</dd>
						</div>
					</dl>
					<div class="project-footer">
						<span class="portfolio-status" data-i18n={`portfolio.project.${index}.status`}>{project.status}</span>
						<div class="tech-tags" aria-label="Tech stack">
							{project.stack.map((tech) => <span>{tech}</span>)}
						</div>
					</div>
				</div>
			</a>
		))}
	</section>

	<script is:inline>
		(function () {
			const buttons = document.querySelectorAll('.filter-button');
			const cards = document.querySelectorAll('.portfolio-card');

			const setPressedState = (activeButton) => {
				buttons.forEach((item) => {
					item.setAttribute('aria-pressed', String(item === activeButton));
				});
			};

			buttons.forEach((button) => {
				button.setAttribute('aria-pressed', button.classList.contains('is-active') ? 'true' : 'false');
				button.addEventListener('click', () => {
					const filter = button.getAttribute('data-filter');
					buttons.forEach((item) => item.classList.remove('is-active'));
					button.classList.add('is-active');
					setPressedState(button);
					cards.forEach((card) => {
						const category = card.getAttribute('data-category');
						card.toggleAttribute('hidden', !(filter === 'all' || category === filter));
					});
				});
			});
		})();
	</script>

	<style>
		.page-title {
			font-size: clamp(2.2rem, 4vw, 3.4rem);
		}

		.page-accent {
			width: 58px;
			height: 4px;
			margin-top: 0.9rem;
			border-radius: 999px;
			background: #17b8ff;
		}

		.portfolio-filters {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 1.5rem;
		}

		.filter-button {
			padding: 0.82rem 1.15rem;
			border: none;
			border-radius: 0.95rem;
			background: rgba(255, 255, 255, 0.05);
			color: #c4af91;
			font: inherit;
			cursor: pointer;
		}

			.filter-button:focus-visible {
				outline: none;
				box-shadow: 0 0 0 3px rgba(23, 184, 255, 0.24);
			}

		.filter-button.is-active {
			background: #179dff;
			color: #ffffff;
			font-weight: 700;
		}

		.portfolio-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 1.25rem;
		}

		.portfolio-card {
			position: relative;
			display: grid;
			overflow: hidden;
			text-decoration: none;
			border-radius: 0.95rem;
			border: 1px solid rgba(97, 213, 255, 0.16);
			background:
				linear-gradient(145deg, rgba(10, 23, 37, 0.96), rgba(7, 12, 22, 0.94)),
				rgba(255, 255, 255, 0.03);
			transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
		}

		.portfolio-card::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 2;
			pointer-events: none;
			background: linear-gradient(90deg, transparent, rgba(97, 213, 255, 0.22), transparent);
			transform: translateX(-110%);
			transition: transform 480ms ease;
		}

		.portfolio-card:hover,
		.portfolio-card:focus-visible {
			transform: translateY(-3px);
			border-color: rgba(97, 213, 255, 0.42);
			box-shadow: 0 20px 50px rgba(0, 0, 0, 0.28);
		}

		.portfolio-card:hover::before,
		.portfolio-card:focus-visible::before {
			transform: translateX(110%);
		}

		.portfolio-card[hidden] {
			display: none;
		}

		.architecture-preview {
			position: relative;
			min-height: 220px;
			overflow: hidden;
			background: #07101b;
		}

		.architecture-preview img {
			width: 100%;
			height: 220px;
			object-fit: cover;
			border-radius: 0;
			opacity: 0.18;
			filter: saturate(0.7) contrast(1.2);
		}

		.architecture-preview svg {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			padding: 1rem;
		}

		.architecture-preview path {
			stroke: rgba(97, 213, 255, 0.58);
			stroke-width: 2;
			stroke-dasharray: 8 10;
		}

		.architecture-preview circle {
			fill: #081321;
			stroke: #61d5ff;
			stroke-width: 2;
		}

		.portfolio-copy {
			padding: 1rem;
		}

		.dossier-meta {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.5rem;
			margin: 0 0 1rem;
		}

		.dossier-meta div {
			padding: 0.52rem;
			border-radius: 0.65rem;
			background: rgba(255, 255, 255, 0.035);
		}

		.dossier-meta dt,
		.dossier-meta dd {
			font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		}

		.dossier-meta dt {
			color: #74849a;
			font-size: 0.62rem;
			letter-spacing: 0.12em;
		}

		.dossier-meta dd {
			margin: 0.14rem 0 0;
			color: #f3f7fb;
			font-size: 0.72rem;
			overflow-wrap: anywhere;
		}

		.portfolio-top {
			display: flex;
			justify-content: space-between;
			gap: 0.8rem;
			align-items: flex-start;
			margin-bottom: 0.7rem;
		}

		.portfolio-top h3 {
			font-size: 1.35rem;
		}

		.portfolio-tag {
			padding: 0.28rem 0.7rem;
			border-radius: 999px;
			background: rgba(10, 187, 255, 0.12);
			color: #19c9ff;
			font-size: 0.78rem;
			font-weight: 700;
		}

		.portfolio-copy p {
			color: #b8c5d2;
			line-height: 1.78;
		}

		.project-facts {
			display: grid;
			gap: 0.65rem;
			margin: 0.9rem 0 0;
		}

		.project-facts div {
			display: grid;
			gap: 0.18rem;
		}

		.project-facts dt {
			color: #19c9ff;
			font-size: 0.78rem;
			font-weight: 700;
			text-transform: uppercase;
		}

		.project-facts dd {
			margin: 0;
			color: #b8c5d2;
			line-height: 1.65;
			font-size: 0.95rem;
		}

		.project-footer {
			display: grid;
			gap: 0.75rem;
			margin-top: 1rem;
		}

		.portfolio-status {
			width: fit-content;
			padding: 0.24rem 0.62rem;
			border-radius: 999px;
			border: 1px solid rgba(25, 201, 255, 0.24);
			color: #d8c0a1;
			font-size: 0.82rem;
			font-weight: 700;
		}

		.tech-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.45rem;
		}

		.tech-tags span {
			padding: 0.2rem 0.52rem;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.05);
			color: #d9e5f1;
			font-size: 0.78rem;
		}

		@media (max-width: 1100px) {
			.portfolio-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 900px) {
			.portfolio-grid {
				grid-template-columns: 1fr;
			}

			.dossier-meta {
				grid-template-columns: 1fr;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.portfolio-card,
			.portfolio-card::before {
				transition: none;
			}

			.portfolio-card:hover,
			.portfolio-card:focus-visible {
				transform: none;
			}
		}
	</style>
</ProfileShell>
