---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import gallery01 from '../assets/img/IMG_20240927_082039_070.jpg';

const sharedProjectImage = gallery01;
const featuredProjects = [
	{ title: 'dotfiles', tag: 'Config', description: 'Bộ cấu hình môi trường làm việc cá nhân cho shell, terminal và workflow hằng ngày.', url: 'https://github.com/Dyu20705/dotfiles', image: sharedProjectImage },
	{ title: 'Personal-Internet-Simulator', tag: 'Simulator', description: 'Mô phỏng hành vi mạng và các thành phần internet ở quy mô cá nhân để thử nghiệm ý tưởng hệ thống.', url: 'https://github.com/Dyu20705/Personal-Internet-Simulator', image: sharedProjectImage },
	{ title: 'myNote', tag: 'Tooling', description: 'Công cụ ghi chú cá nhân tập trung vào tốc độ truy cập và tổ chức nội dung.', url: 'https://github.com/Dyu20705/myNote', image: sharedProjectImage },
	{ title: 'SQUAREXO', tag: 'Game', description: 'Dự án game với logic thi đấu gọn, rõ và có thể mở rộng thêm luật chơi.', url: 'https://github.com/Dyu20705/SQUAREXO', image: sharedProjectImage },
	{ title: 'SmartSpender', tag: 'App', description: 'Ứng dụng quản lý chi tiêu cá nhân với mục tiêu theo dõi dòng tiền đơn giản.', url: 'https://github.com/Dyu20705/SmartSpender', image: sharedProjectImage },
	{ title: 'color-wars', tag: 'Game + AI', description: 'Game chiến thuật theo lượt có tích hợp bot và logic xử lý trạng thái ván chơi.', url: 'https://github.com/Dyu20705/color-wars', image: sharedProjectImage },
];
---
<!doctype html>
<html lang="vi">
  <head>
    <BaseHead title="Portfolio — Duy" />
  </head>
  <body>
    <Header />
    <main style="width:min(1100px,calc(100% - 2rem));margin:2rem auto;">
      <section class="section-panel">
        <h2 class="section-title" data-i18n="section.portfolio.title">Portfolio</h2>
        <div class="grid-3" style="margin-top:1rem;">
          {featuredProjects.map((project) => (
            <a class="portfolio-card" href={project.url} target="_blank" rel="noreferrer">
              <img src={project.image.src} alt={project.title} loading="lazy" />
              <div class="card-body">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class="card-meta">
                  <span class="pill">{project.tag}</span>
                  <strong>Xem repo</strong>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
