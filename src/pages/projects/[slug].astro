---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Copy from '../../components/Copy.astro';
import { publishedProjects, archivedProjectSlugs } from '../../data/content';
export async function getStaticPaths() {
  return [
    ...(await publishedProjects()).map(project => ({params: {slug: project.data.slug}, props: {project}})),
    ...archivedProjectSlugs.map(slug => ({params: {slug}, props: {project: null}})),
  ];
}
const { project } = Astro.props;
const data = project?.data;
---
<SiteLayout activeNav="portfolio" noindex={!data} title={{vi:`${data?.title || 'Dự án lưu trữ'} | Nguyễn Văn Duy`,en:`${data?.title || 'Archived project'} | Nguyễn Văn Duy`}} description={data?.summary || {vi:'Trang dự án cũ không còn được trình bày như bằng chứng hiện tại.',en:'This earlier project page is no longer presented as current evidence.'}}>
  <div class="link-row backlink"><a href="/portfolio"><Copy vi="← Dự án" en="← Portfolio" /></a></div>
  {data ? <>
    <div class="page-intro"><p class="eyebrow"><Copy {...data.domain} /></p><h1>{data.title}</h1><p><Copy {...data.summary} /></p><div class="project-meta"><Copy {...data.status} /> · {data.year}</div><div class="link-row"><a href={data.repoUrl}>Repository <span aria-hidden="true">↗</span></a></div></div>
    <div class="prose">{data.sections.map(section => <section><h2><Copy {...section.heading} /></h2>{section.paragraphs.map(paragraph => <p><Copy {...paragraph} /></p>)}</section>)}</div>
    <section class="evidence-section"><h2><Copy vi="Nguồn bằng chứng" en="Evidence links" /></h2><p class="muted"><Copy vi="Đối chiếu ngày" en="Reviewed on" /> <time datetime={data.verifiedOn}>{data.verifiedOn}</time> · <code>{data.revision}</code></p><ul>{data.evidence.map(item => <li><a href={item.href}><Copy {...item.label} /> <span aria-hidden="true">↗</span></a></li>)}</ul></section>
  </> : <div class="page-intro"><p class="eyebrow"><Copy vi="Lưu trữ" en="Archive" /></p><h1><Copy vi="Trang dự án trước đây" en="An earlier project page" /></h1><p><Copy vi="Nội dung trước đây đã được gỡ khỏi portfolio hiện tại vì chưa được đối chiếu lại. Xem Portfolio để đọc các dự án có bằng chứng được kiểm tra gần đây." en="The previous content has been withdrawn from the current portfolio pending fresh verification. Visit Portfolio for projects with recently checked evidence." /></p></div>}
</SiteLayout>
<style>
 .backlink { margin-top: -24px; margin-bottom: 28px; }
 .evidence-section { max-width: 740px; border-top: 1px solid var(--line); margin-top: 56px; padding-top: 32px; }
 .evidence-section h2 { margin-bottom: 20px; }
 .evidence-section ul { list-style: none; padding: 0; margin: 20px 0 0; }
 .evidence-section a { display: inline-flex; min-height: 44px; align-items: center; }
 code { font-size: .85rem; }
</style>
