	{ title: 'Personal-Internet-Simulator', tag: 'Simulator', description: 'Network / internet behavior simulator.', url: 'https://github.com/Dyu20705/Personal-Internet-Simulator', image: sharedProjectImage },
	{ title: 'myNote', tag: 'Tooling', description: 'Personal note taking and organization tool.', url: 'https://github.com/Dyu20705/myNote', image: sharedProjectImage },
	{ title: 'SQUAREXO', tag: 'Game', description: 'Game project SQUAREXO.', url: 'https://github.com/Dyu20705/SQUAREXO', image: sharedProjectImage },
	{ title: 'SmartSpender', tag: 'App', description: 'Personal finance manager SmartSpender.', url: 'https://github.com/Dyu20705/SmartSpender', image: sharedProjectImage },
	{ title: 'color-wars', tag: 'Game + AI', description: 'Game turn-based ket hop AI bot.', url: 'https://github.com/Dyu20705/color-wars', image: sharedProjectImage },
];

const galleryItems = [
	{ title: 'Gallery 01', caption: 'Photo set 01', image: gallery01 },
	{ title: 'Gallery 02', caption: 'Photo set 02', image: gallery02 },
	{ title: 'Gallery 03', caption: 'Photo set 03', image: gallery03 },
	{ title: 'Gallery 04', caption: 'Photo set 04', image: gallery04 },
	{ title: 'Gallery 05', caption: 'Photo set 05', image: gallery05 },
	{ title: 'Gallery 06', caption: 'Photo set 06', image: gallery06 },
];

const profile = {
	name: 'Nguyen Van Duy',
	roleA: 'System & Infrastructure Engineer',
	roleB: '',
	email: 'nguyenvanduy20072005@gmail.com',
	phone: '0869630908',
	birthday: '20/07/2005',
	location: 'Ha Noi, Viet Nam',
};

const socialLinks = [
	{ id: 'github', label: 'GitHub', href: 'https://github.com/Dyu20705' },
	{ id: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/duynguyenvan05/' },
	{ id: 'leetcode', label: 'LeetCode', href: 'https://leetcode.com/u/Qiskit2030/' },
