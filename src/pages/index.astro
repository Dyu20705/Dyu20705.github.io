						</section>

						<section id="resume" class="section-panel">
							<h2 class="section-title" data-i18n="section.resume.title">Resume</h2>
							<div class="grid-2" style="margin-top: 1rem;">
								<div class="glass-card">
									<h3>Education</h3>
									<div class="timeline">
										{education.map((item) => (
											<div class="timeline-item">
												<strong>{item.title}</strong>
												<small>{item.time}</small>
												<p>{item.body}</p>
											</div>
										))}
									</div>
								</div>
								<div class="glass-card">
									<h3>Experience</h3>
									<div class="timeline">
										{experience.map((item) => (
											<div class="timeline-item">
												<strong>{item.title}</strong>
												<small>{item.time}</small>
												<p>{item.body}</p>
											</div>
										))}
									</div>
								</div>
							</div>

							<div class="grid-3" style="margin-top: 0.85rem;">
								{skillGroups.map((group) => (
									<div class="glass-card">
										<h3>{group.title}</h3>
										<div style="margin-top:0.6rem;display:grid;gap:0.45rem;">
											{group.items.map((it) => (
												<div style="display:flex;align-items:center;gap:0.6rem;">
													<div style="flex:1;">
														<div style="height:10px;background:rgba(255,255,255,0.07);border-radius:6px;overflow:hidden;">
															<div style={`width:${it.value}% ;height:100%;background:linear-gradient(90deg,#61d3ff,#2b8cff);transition:width:420ms ease;`}></div>
														</div>
													</div>
													<strong style="width:120px;text-align:right;color:#cde8ff;font-size:0.85rem;">{it.value}%</strong>
												</div>
											))}
										</div>
									</div>
								))}
							</div>
						</section>

						<section id="portfolio" class="section-panel">
							<h2 class="section-title" data-i18n="section.portfolio.title">Portfolio</h2>
							
							<div class="grid-3" style="margin-top: 1rem;">
								{featuredProjects.map((project) => (
									<a class="portfolio-card" href={project.url} target="_blank" rel="noreferrer">
										<img src={project.image.src} alt={project.title} loading="lazy" />
										<div class="card-body">
											<h3>{project.title}</h3>
											<p>{project.description}</p>
											<div class="card-meta">
												<span class="pill">{project.tag}</span>
												<strong>Xem repo</strong>
											</div>
										</div>
									</a>
								))}
							</div>
						</section>

						<section id="blog" class="section-panel">
							<h2 class="section-title" data-i18n="section.blog.title">Blog</h2>
							<div class="grid-3 blog-grid" style="margin-top: 1rem;">
								{posts.map((post, index) => (
									<a class="blog-card" href={`/blog/${post.id}/`}>
										<img src={postCovers[index % postCovers.length].src} alt={post.data.title} loading="lazy" />
										<div class="card-body">
											<span class="pill">
												{post.data.pubDate.toLocaleDateString('vi-VN', {
													year: 'numeric',
													month: '2-digit',
													day: '2-digit',
												})}
											</span>
											<h3>{post.data.title}</h3>
											<p>{post.data.description}</p>
											<div class="card-meta">
												<span class="pill">Blog</span>
												<strong>Doc bai viet</strong>
											</div>
										</div>
									</a>
								))}
							</div>
						</section>

						<section id="contact" class="section-panel">
							<h2 class="section-title" data-i18n="section.contact.title">Contact</h2>
							<div class="contact-grid">
								<div class="contact-card">
									<small>Email</small>
									<a href={`mailto:${profile.email}`}>{profile.email}</a>
								</div>
								<div class="contact-card">
									<small>Phone</small>
									<a href="tel:+848696390908">{profile.phone}</a>
								</div>
								<div class="contact-card">
									<small>Location</small>
									<span>{profile.location}</span>
								</div>
