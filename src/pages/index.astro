---
import SiteLayout from '../layouts/SiteLayout.astro';
import Copy from '../components/Copy.astro';
import ProjectList from '../components/projects/ProjectList.astro';
import { publishedProjects } from '../data/content';
const projects = (await publishedProjects()).filter(project => project.data.featured).slice(0, 2);
---
<SiteLayout title={{vi:'Nguyễn Văn Duy | Computer Science Student',en:'Nguyễn Văn Duy | Computer Science Student'}} description={{vi:'Sinh viên Khoa học máy tính. Định hướng ML Systems, MLOps, Platform Engineering và các hệ thống nghiên cứu.',en:'Computer Science Student exploring ML Systems, MLOps, Platform Engineering and research-oriented systems.'}}>
  <section class="home-intro">
    <p class="eyebrow"><Copy vi="Portfolio cá nhân" en="Personal portfolio" /></p>
    <h1>Nguyễn Văn Duy</h1>
    <p class="home-role">Computer Science Student</p>
    <p class="home-direction"><Copy vi="Định hướng ML Systems, MLOps và Platform Engineering, qua các dự án phần mềm và nghiên cứu hệ thống." en="Exploring ML Systems, MLOps and Platform Engineering through software projects and research-oriented systems." /></p>
    <div class="link-row"><a href="/portfolio"><Copy vi="Xem dự án" en="Portfolio" /> <span aria-hidden="true">↗</span></a><a href="https://github.com/Dyu20705">GitHub <span aria-hidden="true">↗</span></a><a href="/resume"><Copy vi="Hồ sơ" en="Resume" /> <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="current-work" aria-labelledby="current-work-title">
    <h2 id="current-work-title"><Copy vi="Đang thực hiện" en="Current work" /></h2>
    <div><a class="current-name" href="/projects/sites/">SITES <span aria-hidden="true">↗</span></a><p><Copy vi="Chuẩn bị nghiên cứu Month-1: bằng chứng học thuật, phạm vi hẹp và một lát cắt có thể tái lập. Chưa có product implementation." en="Month-1 research preparation: scholarly evidence, a narrow scope and one reproducible slice. No current product implementation yet." /></p></div>
  </section>
  <section class="editorial-section" aria-labelledby="selected-work-title">
    <div class="section-heading"><h2 id="selected-work-title"><Copy vi="Dự án chọn lọc" en="Selected work" /></h2><a href="/portfolio"><Copy vi="Xem tất cả" en="All projects" /> <span aria-hidden="true">↗</span></a></div>
    <ProjectList projects={projects} headingLevel="h3" />
  </section>
</SiteLayout>
<style>
  .home-intro { max-width: 880px; }
  .home-intro h1 { font-size: clamp(2.65rem, 6vw, 5rem); }
  .home-role { margin-top: 22px; color: var(--text); font-size: 1.25rem; }
  .home-direction { max-width: 650px; margin-top: 18px; font-size: 1.15rem; }
  .home-intro .link-row { margin-top: 28px; }
  .current-work { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 36px; margin-top: 80px; padding-top: 32px; border-top: 1px solid var(--line); }
  .current-work h2 { font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); padding-top: 12px; }
  .current-name { min-height: 44px; display: inline-flex; align-items: center; gap: 12px; font-size: 1.3rem; text-decoration: none; }
  .current-work p { max-width: 660px; margin-top: 10px; }
  @media(max-width:767px) { .home-direction { font-size: 1rem; } .current-work { grid-template-columns: 1fr; gap: 10px; margin-top: 48px; } .home-role { font-size: 1.1rem; } }
</style>
