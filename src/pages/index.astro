												<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h4v-2H3v2zm6 6h4v-2h-4v2zm6-12v2h4V7h-4zM9 7h6v10H9V7z"/></svg>
											) : (
												<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v4H4zM4 12h16v8H4z"/></svg>
											)}
										</div>
										<div>
