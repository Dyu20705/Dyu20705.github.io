						<section id="cv" class="section-panel">
							<h2 class="section-title" data-i18n="section.cv.title">CV</h2>
							<iframe class="cv-frame" src={cvFile} title="Nguyen Van Duy CV"></iframe>
							<div class="cv-actions">
								<a href={cvFile} target="_blank" rel="noreferrer">Mo CV tab moi</a>
								<a href={cvFile} download="NguyenVanDuy_CV.pdf">Tai CV</a>
							</div>
						</section>
					</div>
				</div>
			</div>
		</main>
		<script is:inline>
			(function () {
				const btn = document.getElementById('lang-float');
				const translations = {
					en: {
						'section.about.title': 'About Me',
						'section.resume.title': 'Resume',
						'section.portfolio.title': 'Portfolio',
						'section.blog.title': 'Blog',
						'section.contact.title': 'Contact',
						'section.gallery.title': 'Gallery',
						'section.cv.title': 'CV',
						'role.main': 'System & Infrastructure Engineer',
					},
					vi: {
						'section.about.title': 'Về tôi',
						'section.resume.title': 'Hồ sơ',
						'section.portfolio.title': 'Dự án',
						'section.blog.title': 'Blog',
						'section.contact.title': 'Liên hệ',
						'section.gallery.title': 'Thư viện',
						'section.cv.title': 'CV',
						'role.main': 'System & Infrastructure Engineer',
					},
				};

				function applyLang(lang) {
					document.querySelectorAll('[data-i18n]').forEach((el) => {
						const key = el.getAttribute('data-i18n');
						if (key && translations[lang]?.[key]) el.innerText = translations[lang][key];
					});
					document.querySelectorAll('[data-i18n-role]').forEach((el) => {
						el.innerText = translations[lang]['role.main'];
					});
					document.documentElement.lang = lang;
					if (btn) btn.textContent = lang === 'vi' ? 'EN' : 'VI';
					localStorage.setItem('siteLang', lang);
				}

				const current = localStorage.getItem('siteLang') || 'vi';
				applyLang(current);
				if (btn) btn.addEventListener('click', () => applyLang(localStorage.getItem('siteLang') === 'vi' ? 'en' : 'vi'));
			})();
		</script>
		<script type="module" define:vars={{ entranceSong, goodbyeSong }}>
			const toggle = document.getElementById('audio-toggle');
			const revealTargets = document.querySelectorAll(
				'.section-panel, .glass-card, .portfolio-card, .blog-card, .gallery-card, .contact-card, .cv-frame, .cv-actions, .profile-photo, .role-badges, .info-list, .social-row, .tab-nav',
			);

			let enabled = false;
			let entrancePlayed = false;
			let goodbyePlayed = false;
			let fadeTimer = null;

			const fadeAudio = (audio, from, to, duration) => {
				if (!audio) return;
				if (fadeTimer) window.clearInterval(fadeTimer);
				const start = performance.now();
				fadeTimer = window.setInterval(() => {
					const elapsed = performance.now() - start;
					const progress = Math.min(elapsed / duration, 1);
					audio.volume = from + (to - from) * progress;
					if (progress >= 1) {
						window.clearInterval(fadeTimer);
						fadeTimer = null;
					}
				}, 32);
			};

			const playClip = (source, startVolume, targetVolume, duration) => {
				const audio = new Audio(source);
				audio.volume = startVolume;
				audio.play().catch(() => {});
				fadeAudio(audio, startVolume, targetVolume, duration);
				return audio;
			};

			const playEntrance = () => {
				if (!enabled || entrancePlayed) return;
				entrancePlayed = true;
				playClip(entranceSong, 0.01, 0.1, 900);
			};

			const playGoodbye = () => {
				if (!enabled || goodbyePlayed) return;
				goodbyePlayed = true;
				playClip(goodbyeSong, 0.01, 0.08, 700);
			};

			const activateAudio = () => {
				enabled = true;
				if (toggle) toggle.setAttribute('data-active', 'true');
				playEntrance();
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
			);

			revealTargets.forEach((target, index) => {
				target.setAttribute('data-reveal', '');
				target.style.transitionDelay = `${Math.min(index * 40, 280)}ms`;
				observer.observe(target);
			});

			if (toggle) {
				toggle.addEventListener('click', activateAudio, { once: true });
			}

			window.addEventListener('pointerdown', activateAudio, { once: true });
			window.addEventListener('focus', activateAudio, { once: true });
			window.addEventListener('visibilitychange', () => {
				if (document.visibilityState === 'hidden') playGoodbye();
			});
			window.addEventListener('pagehide', playGoodbye, { capture: true });
		</script>
	</body>
</html>
