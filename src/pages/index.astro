												<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 18H6a4 4 0 010-8c.21 0 .42.02.63.06A6 6 0 1119 18z"/></svg>
											) : card.icon === 'container' ? (
												<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7L12 3 3 7z"/></svg>
