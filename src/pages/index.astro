const postCovers = [sharedProjectImage];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main.portfolio-page {
				width: min(1320px, calc(100% - 2rem));
				padding-top: 1rem;
			}

			.layout {
				display: grid;
				grid-template-columns: 320px minmax(0, 1fr);
				gap: 1.25rem;
				align-items: start;
			}

			.sidebar-card,
			.workspace {
				border: 1px solid var(--line);
				border-radius: var(--radius-lg);
				background: rgba(10, 18, 30, 0.9);
				box-shadow: 0 24px 46px rgba(0, 0, 0, 0.32);
			}

			.sidebar-card {
				position: sticky;
				top: 1rem;
				padding: 1.25rem;
			}

			.profile-photo {
				display: block;
				width: 122px;
				height: 122px;
				object-fit: cover;
				object-position: center top;
				margin: 0 auto;
				border-radius: 1rem;
				border: 1px solid rgba(157, 212, 255, 0.35);
			}

			.profile-name {
				margin-top: 0.9rem;
				font-size: 1.9rem;
				text-align: center;
			}

			.role-badges {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.45rem;
				margin-top: 0.5rem;
			}

			.role-badges span {
				padding: 0.26rem 0.68rem;
				font-size: 0.75rem;
				border-radius: 999px;
				background: rgba(17, 36, 57, 0.95);
				border: 1px solid rgba(159, 215, 255, 0.2);
				color: #cde8ff;
			}

			.info-list {
				margin-top: 1.1rem;
				padding-top: 1rem;
				border-top: 1px solid rgba(157, 212, 255, 0.16);
				display: grid;
				gap: 0.72rem;
			}

			.info-item {
				display: grid;
				gap: 0.15rem;
			}

			.info-item small {
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #77a0bf;
			}

			.info-item a,
			.info-item span {
				font-size: 0.95rem;
				text-decoration: none;
				color: #e7f5ff;
			}

					.social-row {
						display: flex;
						gap: 0.5rem;
						margin-top: 1rem;
						padding-top: 1rem;
						border-top: 1px solid rgba(157, 212, 255, 0.16);
					}

					.social-row a {
						flex: 1 1 auto;
						display: inline-flex;
						align-items: center;
						justify-content: center;
						gap: 0.5rem;
						padding: 0.5rem 0.6rem;
						font-size: 0.85rem;
						border-radius: 0.6rem;
						text-decoration: none;
						border: 1px solid rgba(120, 189, 235, 0.24);
						background: rgba(12, 29, 46, 0.95);
						transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
					}

					.social-row a:hover {
						transform: translateY(-1px);
						border-color: rgba(97, 213, 255, 0.4);
						background: rgba(15, 37, 58, 0.96);
					}

					.social-row svg {
						width: 20px;
						height: 20px;
						display: block;
						fill: currentColor;
					}

					.sr-only {
						position: absolute !important;
						width: 1px;
						height: 1px;
						padding: 0;
						margin: -1px;
						overflow: hidden;
						clip: rect(0, 0, 0, 0);
						white-space: nowrap;
						border: 0;
					}

			.workspace {
				overflow: hidden;
			}

			.tab-nav {
				display: flex;
				gap: 0.45rem;
				flex-wrap: wrap;
				padding: 0.85rem 1rem;
				border-bottom: 1px solid rgba(157, 212, 255, 0.16);
				background: rgba(6, 12, 22, 0.72);
			}

			.tab-nav a {
				padding: 0.38rem 0.72rem;
				border-radius: 0.65rem;
				font-size: 0.85rem;
				text-decoration: none;
				color: #a9c7df;
				border: 1px solid transparent;
				transition: all 180ms ease;
			}

			.tab-nav a:hover {
				color: #f2fbff;
				border-color: rgba(118, 197, 245, 0.32);
				background: rgba(13, 39, 58, 0.8);
			}

			.content {
				padding: 1.15rem;
				display: grid;
				gap: 1rem;
			}

			.section-panel {
				padding: 1.15rem;
				border: 1px solid rgba(157, 212, 255, 0.14);
				border-radius: 1rem;
				background:
					radial-gradient(circle at top right, rgba(106, 190, 234, 0.08), transparent 44%),
					rgba(8, 16, 28, 0.88);
				scroll-margin-top: 1rem;
				transition:
					transform 220ms ease,
					border-color 220ms ease,
					box-shadow 220ms ease;
			}

			.section-panel:hover {
				transform: translateY(-1px);
				border-color: rgba(97, 213, 255, 0.22);
				box-shadow: 0 20px 48px rgba(0, 0, 0, 0.18);
			}

			[data-reveal] {
				opacity: 0;
				transform: translateY(14px);
				transition:
					opacity 500ms ease,
					transform 500ms ease;
			}

			[data-reveal].is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			.section-title {
				font-size: clamp(1.7rem, 3vw, 2.2rem);
			}

			.section-subline {
				margin-top: 0.65rem;
				color: #9ec1da;
				line-height: 1.75;
			}

			.grid-2,
			.grid-3 {
				display: grid;
				gap: 0.85rem;
			}

			.grid-2 {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.grid-3 {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}

			.glass-card {
				padding: 0.95rem;
				border-radius: 0.85rem;
				border: 1px solid rgba(157, 212, 255, 0.16);
				background: rgba(10, 24, 38, 0.72);
				transition:
					transform 220ms ease,
					border-color 220ms ease,
					box-shadow 220ms ease;
			}

			.glass-card:hover {
				transform: translateY(-2px);
				border-color: rgba(97, 213, 255, 0.22);
				box-shadow: 0 16px 32px rgba(0, 0, 0, 0.16);
			}

			.glass-card h3 {
				font-size: 1.1rem;
			}

			.glass-card p,
			.glass-card li {
				margin-top: 0.45rem;
				color: #a4c2d9;
				line-height: 1.72;
				font-size: 0.95rem;
			}

			.timeline {
				margin-top: 0.8rem;
				display: grid;
				gap: 0.9rem;
			}

			.timeline-item {
				padding-left: 1rem;
				border-left: 2px solid rgba(95, 196, 255, 0.85);
			}

			.timeline-item strong {
				display: block;
				font-size: 1.03rem;
				color: #eff9ff;
			}

			.timeline-item small {
				display: block;
				margin-top: 0.2rem;
				color: #62c8ff;
			}

			.skill-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-top: 0.55rem;
			}

			.skill-tags span,
			.pill {
				padding: 0.2rem 0.55rem;
				border-radius: 999px;
				font-size: 0.78rem;
				border: 1px solid rgba(114, 201, 245, 0.24);
				background: rgba(17, 37, 55, 0.95);
				color: #9ddbff;
			}

			.portfolio-card,
			.blog-card,
			.gallery-card {
				display: grid;
				overflow: hidden;
				text-decoration: none;
				border-radius: 0.95rem;
				border: 1px solid rgba(157, 212, 255, 0.2);
				background: rgba(7, 15, 26, 0.92);
				transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, filter 220ms ease;
			}

			.portfolio-card:hover,
			.blog-card:hover,
			.gallery-card:hover {
				transform: translateY(-4px) scale(1.01);
				border-color: rgba(97, 207, 253, 0.45);
				box-shadow: 0 18px 34px rgba(0, 0, 0, 0.26);
			}

			.portfolio-card img,
			.blog-card img,
			.gallery-card img {
				width: 100%;
				height: 170px;
				object-fit: cover;
				object-position: center;
				border-radius: 0;
			}

			.card-body {
				padding: 0.9rem;
			}

			.card-body h3 {
				font-size: 1.12rem;
			}

			.card-body p {
				margin-top: 0.45rem;
				font-size: 0.92rem;
				color: #9bbad2;
			}

			.card-meta {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.5rem;
				margin-top: 0.7rem;
			}

			.card-meta strong {
				font-size: 0.88rem;
				color: #63d3ff;
			}

			.blog-grid .card-body {
				padding-top: 0.75rem;
			}

			.contact-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.8rem;
				margin-top: 1rem;
			}

			.contact-card {
				padding: 0.78rem 0.85rem;
				border-radius: 0.75rem;
				border: 1px solid rgba(157, 212, 255, 0.18);
				background: rgba(13, 33, 50, 0.78);
			}

			.contact-card small {
				display: block;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #77a2c1;
			}

			.contact-card span,
			.contact-card a {
				display: block;
				margin-top: 0.24rem;
				color: #e8f7ff;
				text-decoration: none;
			}

			.contact-form {
				margin-top: 1rem;
				display: grid;
				gap: 0.72rem;
			}

			.contact-form .row {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.72rem;
			}

			input,
			textarea {
				width: 100%;
				padding: 0.72rem 0.85rem;
				border-radius: 0.75rem;
				border: 1px solid rgba(157, 212, 255, 0.2);
				background: rgba(5, 12, 21, 0.9);
				color: #e6f5ff;
				font: inherit;
			}

			textarea {
				min-height: 130px;
				resize: vertical;
			}

			button {
				width: fit-content;
				padding: 0.62rem 1.25rem;
				border-radius: 0.8rem;
				border: 1px solid rgba(69, 194, 244, 0.3);
				background: linear-gradient(120deg, #2eb7ff 0%, #46d4cf 100%);
				color: #062334;
				font-weight: 700;
				cursor: pointer;
			}

			.cv-frame {
				width: 100%;
				height: 600px;
				border-radius: 0.95rem;
				border: 1px solid rgba(157, 212, 255, 0.26);
				background: #ffffff;
			}

			.cv-actions {
				display: flex;
				gap: 0.65rem;
				margin-top: 0.85rem;
				flex-wrap: wrap;
			}

			.cv-actions a {
				padding: 0.5rem 0.8rem;
				border-radius: 0.7rem;
				font-size: 0.86rem;
				text-decoration: none;
				border: 1px solid rgba(157, 212, 255, 0.22);
				background: rgba(12, 30, 46, 0.82);
				transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
			}

			.cv-actions a:hover {
				transform: translateY(-1px);
				border-color: rgba(97, 213, 255, 0.34);
				background: rgba(15, 37, 58, 0.95);
			}

			.speaker-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				min-width: 2.7rem;
				padding: 0.42rem 0.75rem;
				border-radius: 999px;
				border: 1px solid rgba(157, 212, 255, 0.2);
				background: rgba(8, 18, 29, 0.9);
				color: #dff4ff;
				font-size: 0.8rem;
				cursor: pointer;
			}

			.speaker-toggle[data-active='true'] {
				border-color: rgba(108, 216, 255, 0.55);
				box-shadow: 0 0 0 1px rgba(108, 216, 255, 0.16) inset;
			}

			.speaker-toggle:hover {
				transform: translateY(-1px);
			}

			@media (max-width: 1120px) {
				.layout {
					grid-template-columns: 1fr;
				}

				.sidebar-card {
					position: static;
				}
			}

			@media (max-width: 900px) {
				.grid-3,
				.grid-2,
				.contact-grid {
					grid-template-columns: 1fr;
				}

				.contact-form .row {
					grid-template-columns: 1fr;
				}

				.portfolio-card img,
				.blog-card img,
				.gallery-card img {
					height: 190px;
				}
			}
		</style>
	</head>
	<body>
		<button id="lang-float" aria-label="Toggle language" title="Toggle language" style="position:fixed;right:18px;bottom:18px;z-index:60;min-width:44px;padding:0.5rem 0.8rem;border-radius:999px;border:1px solid rgba(120,169,255,0.18);background:linear-gradient(180deg,rgba(10,18,30,0.9),rgba(10,18,30,0.6));color:var(--text-strong);box-shadow:0 6px 18px rgba(0,0,0,0.45);">VI</button>
		<main class="portfolio-page">
			<div class="layout">
				<aside class="sidebar-card">
					<img class="profile-photo" src={profilePhoto.src} alt="Nguyen Van Duy profile" loading="lazy" />
					<h1 class="profile-name">{profile.name}</h1>
					<div class="role-badges">
						<span data-i18n-role>{profile.roleA}</span>
					</div>

					<div class="info-list">
						<div class="info-item">
							<small>Email</small>
							<a href={`mailto:${profile.email}`}>{profile.email}</a>

						</div>
						<div class="info-item">
							<small>Phone</small>
							<a href="tel:+848696390908">{profile.phone}</a>
						</div>
						<div class="info-item">
							<small>Birthday</small>
							<span>{profile.birthday}</span>
						</div>
						<div class="info-item">
							<small>Location</small>
							<span>{profile.location}</span>
						</div>
					</div>

					<div class="social-row">
						{socialLinks.map((item) => (
							<a href={item.href} target="_blank" rel="noreferrer" aria-label={item.label} title={item.label}>
								{item.id === 'github' ? (
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path d="M12 0.297c-6.627 0-12 5.373-12 12 0 5.302 3.438 9.8 8.205 11.387.6.111.82-.261.82-.58 0-.285-.01-1.04-.016-2.04-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.744.084-.729.084-.729 1.205.085 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.775.418-1.305.762-1.605-2.665-.305-5.466-1.332-5.466-5.93 0-1.31.468-2.381 1.235-3.221-.123-.303-.535-1.527.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.649.241 2.873.118 3.176.77.84 1.233 1.911 1.233 3.221 0 4.61-2.805 5.62-5.476 5.92.43.371.814 1.102.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.218.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
									</svg>
								) : item.id === 'linkedin' ? (
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.22 8.98h4.53V24H.22zM8.98 8.98h4.34v2.06h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V24h-4.53v-6.84c0-1.63-.03-3.74-2.28-3.74-2.28 0-2.63 1.78-2.63 3.62V24H8.98V8.98z"/>
									</svg>
								) : (
									<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
										<path d="M3 12l8-8 8 8-8 8-8-8zm8-6.4L5.4 12 11 17.6 16.6 12 11 5.6z"/>
									</svg>
								)}
								<span class="sr-only">{item.label}</span>
