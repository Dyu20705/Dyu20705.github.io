		items: [
			{ name: 'TypeScript', value: 85 },
			{ name: 'Python', value: 80 },
			{ name: 'JavaScript', value: 80 },
			{ name: 'C#', value: 60 },
		],
	},
	{
		title: 'Backend & Infra',
		items: [
			{ name: 'Node.js', value: 80 },
			{ name: 'REST API', value: 75 },
			{ name: 'Docker', value: 70 },
			{ name: 'Nginx', value: 70 },
			{ name: 'Linux', value: 85 },
		],
	},
	{
		title: 'Dev Tools',
		items: [
			{ name: 'GitHub Actions', value: 75 },
			{ name: 'CI/CD', value: 80 },
			{ name: 'Testing', value: 70 },
