						<section id="cv" class="section-panel">
							<h2 class="section-title">CV</h2>
							<p class="section-subline">File CV goc duoc nap truc tiep tu assets/cv de xem nhanh va tai xuong.</p>
							<iframe class="cv-frame" src={cvFile} title="Nguyen Van Duy CV"></iframe>
							<div class="cv-actions">
								<a href={cvFile} target="_blank" rel="noreferrer">Mo CV tab moi</a>
								<a href={cvFile} download="NguyenVanDuy_CV.pdf">Tai CV</a>
							</div>
						</section>
					</div>
				</div>
			</div>
		</main>
		<script type="module" define:vars={{ entranceSong, goodbyeSong }}>
			const toggle = document.getElementById('audio-toggle');
			const revealTargets = document.querySelectorAll(
				'.section-panel, .glass-card, .portfolio-card, .blog-card, .gallery-card, .contact-card, .cv-frame, .cv-actions, .profile-photo, .role-badges, .info-list, .social-row, .tab-nav',
			);

			let enabled = false;
			let entrancePlayed = false;
			let goodbyePlayed = false;
			let fadeTimer = null;

			const fadeAudio = (audio, from, to, duration) => {
				if (!audio) return;
				if (fadeTimer) window.clearInterval(fadeTimer);
				const start = performance.now();
				fadeTimer = window.setInterval(() => {
					const elapsed = performance.now() - start;
					const progress = Math.min(elapsed / duration, 1);
					audio.volume = from + (to - from) * progress;
					if (progress >= 1) {
						window.clearInterval(fadeTimer);
						fadeTimer = null;
					}
				}, 32);
			};

			const playClip = (source, startVolume, targetVolume, duration) => {
				const audio = new Audio(source);
				audio.volume = startVolume;
				audio.play().catch(() => {});
				fadeAudio(audio, startVolume, targetVolume, duration);
				return audio;
			};

			const playEntrance = () => {
				if (!enabled || entrancePlayed) return;
				entrancePlayed = true;
				playClip(entranceSong, 0.01, 0.1, 900);
			};

			const playGoodbye = () => {
				if (!enabled || goodbyePlayed) return;
				goodbyePlayed = true;
				playClip(goodbyeSong, 0.01, 0.08, 700);
			};

			const activateAudio = () => {
				enabled = true;
				if (toggle) toggle.setAttribute('data-active', 'true');
				playEntrance();
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
			);

			revealTargets.forEach((target, index) => {
				target.setAttribute('data-reveal', '');
				target.style.transitionDelay = `${Math.min(index * 40, 280)}ms`;
				observer.observe(target);
			});

			if (toggle) {
				toggle.addEventListener('click', activateAudio, { once: true });
			}

			window.addEventListener('pointerdown', activateAudio, { once: true });
			window.addEventListener('focus', activateAudio, { once: true });
			window.addEventListener('visibilitychange', () => {
				if (document.visibilityState === 'hidden') playGoodbye();
			});
			window.addEventListener('pagehide', playGoodbye, { capture: true });
		</script>
	</body>
</html>