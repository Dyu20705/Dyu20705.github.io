---
import SiteLayout from '../layouts/SiteLayout.astro';
import Copy from '../components/Copy.astro';
import { profile } from '../data/site';
---
<SiteLayout activeNav="contact" title={{vi:'Liên hệ | Nguyễn Văn Duy',en:'Contact | Nguyễn Văn Duy'}} description={{vi:'Liên hệ Nguyễn Văn Duy về dự án, nghiên cứu, thực tập và cơ hội kỹ thuật.',en:'Contact Nguyễn Văn Duy about projects, research, internships and technical opportunities.'}}>
  <div class="page-intro"><p class="eyebrow"><Copy vi="Liên hệ" en="Contact" /></p><h1><Copy vi="Trao đổi qua email." en="Get in touch." /></h1><p><Copy vi="Về dự án, nghiên cứu, thực tập hoặc cơ hội kỹ thuật. Email là cách liên hệ chính; các hồ sơ công khai ở cuối trang." en="For project discussions, research, internships or technical opportunities. Email is the primary way to reach me; public profiles are linked below." /></p><div class="link-row"><a href={`mailto:${profile.email}`}><Copy vi="Gửi email" en="Email me" /> <span aria-hidden="true">↗</span></a></div></div>
  <form class="contact-form" action={`mailto:${profile.email}`} method="post" enctype="text/plain" data-contact-email={profile.email}>
    <h2><Copy vi="Soạn tin nhắn" en="Compose a message" /></h2>
    <p class="muted"><Copy vi="Form này mở ứng dụng email của bạn, không gửi qua máy chủ website." en="This form opens your email application; it does not send through a website server." /></p>
    <div class="form-row"><label><Copy vi="Họ tên" en="Name" /><input name="name" autocomplete="name" required /></label><label><Copy vi="Email của bạn" en="Your email" /><input type="email" name="email" autocomplete="email" required /></label></div>
    <label><Copy vi="Nội dung" en="Message" /><textarea name="message" rows="6" required></textarea></label>
    <button class="submit-button" type="submit"><Copy vi="Mở ứng dụng email" en="Open email application" /></button>
    <p class="form-status" role="status" hidden><Copy vi="Đã yêu cầu mở ứng dụng email. Nếu không mở được, hãy dùng liên kết email ở cuối trang." en="Your email application was requested. If it does not open, use the email link in the footer." /></p>
  </form>
</SiteLayout>
<script>
 const form = document.querySelector<HTMLFormElement>('.contact-form');
 form?.addEventListener('submit', event => {
   event.preventDefault();
   const fields = new FormData(form);
   const name = String(fields.get('name') || '');
   const email = String(fields.get('email') || '');
   const message = String(fields.get('message') || '');
   const subject = encodeURIComponent(`Portfolio contact: ${name}`);
   const body = encodeURIComponent(`${name}
${email}

${message}`);
   window.location.href = `mailto:${form.dataset.contactEmail}?subject=${subject}&body=${body}`;
   const status = form.querySelector<HTMLElement>('.form-status');
   if (status) status.hidden = false;
 });
</script>
<style>
 .contact-form { max-width: 740px; display: grid; gap: 24px; padding-top: 36px; border-top: 1px solid var(--line); }
 .contact-form > h2 { font-size: 1.35rem; }
 .contact-form .muted { font-size: .85rem; }
 .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
 label { display: block; }
 input, textarea { display: block; width: 100%; min-height: 48px; margin-top: 10px; padding: 12px; background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 4px; }
 textarea { resize: vertical; }
 .submit-button { justify-self: start; min-height: 48px; padding: 12px 20px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); }
 .submit-button:hover { border-color: var(--accent); }
 .form-status { font-size: .85rem; }
 @media(max-width:767px) { .form-row { grid-template-columns: 1fr; } }
</style>
