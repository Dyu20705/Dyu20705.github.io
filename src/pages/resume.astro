---
import SiteLayout from '../layouts/SiteLayout.astro';
import Copy from '../components/Copy.astro';
---
<SiteLayout activeNav="resume" title={{vi:'Hồ sơ | Nguyễn Văn Duy',en:'Resume | Nguyễn Văn Duy'}} description={{vi:'Học vấn, dự án kỹ thuật và công cụ của Nguyễn Văn Duy, sinh viên Khoa học máy tính.',en:'Education, engineering projects and tools of Nguyễn Văn Duy, Computer Science Student.'}}>
  <div class="page-intro"><p class="eyebrow">Resume</p><h1><Copy vi="Hồ sơ" en="Resume" /></h1><p>Computer Science Student</p><div class="link-row"><a href="/cv"><Copy vi="Xem CV PDF" en="View PDF CV" /> <span aria-hidden="true">↗</span></a></div></div>
  <div class="resume-sections">
    <section class="resume-section"><h2><Copy vi="Học vấn" en="Education" /></h2><div><h3><Copy vi="Đại học Giao thông Vận tải" en="University of Transport and Communications" /></h3><p><Copy vi="Khoa học máy tính · Hà Nội" en="Computer Science · Hanoi" /></p><p class="muted"><Copy vi="2023–hiện tại" en="2023–present" /></p></div></section>
    <section class="resume-section"><h2><Copy vi="Kinh nghiệm kỹ thuật" en="Engineering experience" /></h2><div class="experience-list">
      <article><h3><a href="/projects/sites/">SITES</a></h3><p class="muted"><Copy vi="Dự án nghiên cứu và kỹ thuật · 2026" en="Research & Engineering Project · 2026" /></p><p><Copy vi="Chuẩn bị nghiên cứu về sự thay đổi của khái niệm trong tài liệu học thuật: research protocol, evidence ledger, evaluation và phạm vi Month-1. Chưa có product implementation." en="Research preparation for studying concept evolution in scholarly literature: research protocol, evidence ledger, evaluation and Month-1 scope. No current product implementation yet." /></p></article>
      <article><h3><a href="/projects/opendownloader/">openDownloader</a></h3><p class="muted"><Copy vi="Dự án phần mềm độc lập · 2026" en="Independent Software Project · 2026" /></p><p><Copy vi="Ứng dụng desktop Rust/Tauri với frontend React, child-process media tools, SQLite và workflow kiểm tra/đóng gói. Có release công khai; giới hạn production support được ghi trên trang dự án." en="Rust/Tauri desktop application with a React frontend, child-process media tools, SQLite and check/packaging workflows. Public releases exist; production-support limits are recorded on the project page." /></p></article>
    </div></section>
    <section class="resume-section"><h2><Copy vi="Kỹ năng cốt lõi" en="Core skills" /></h2><div class="skills-list">
      <div><h3><Copy vi="Công cụ dùng trong dự án" en="Tools used in projects" /></h3><p>Rust · TypeScript · React · Tauri · SQLite · Git · GitHub Actions</p><p class="muted"><Copy vi="Desktop/backend boundaries, process orchestration, validation, packaging và tài liệu kỹ thuật." en="Desktop/backend boundaries, process orchestration, validation, packaging and technical documentation." /></p></div>
      <div><h3><Copy vi="Đang phát triển" en="Development areas" /></h3><p>ML Systems · MLOps · ML Infrastructure · Platform Engineering</p><p class="muted"><Copy vi="Research protocols, scholarly evidence, reproducibility và evaluation design." en="Research protocols, scholarly evidence, reproducibility and evaluation design." /></p></div>
    </div></section>
  </div>
</SiteLayout>
<style>
 .resume-sections { max-width: 1040px; }
 .resume-section { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 48px; padding-block: 36px; border-top: 1px solid var(--line); }
 .resume-section > h2 { font-size: 1.1rem; }
 .resume-section h3 { margin-bottom: 12px; }
 .resume-section p + p { margin-top: 12px; }
 .resume-section h3 a { text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
 .experience-list, .skills-list { display: grid; gap: 36px; }
 @media(max-width:767px) { .resume-section { grid-template-columns: 1fr; gap: 24px; } }
</style>
