---
import ProfileShell from '../layouts/ProfileShell.astro';
import { education, experience, skills } from '../data/site';
---

<ProfileShell
	headTitle="Hồ sơ | Nguyễn Văn Duy"
	description="Học vấn, kinh nghiệm và kỹ năng chính của Nguyễn Văn Duy."
	activeNav="resume"
>
	<section class="page-section">
		<h2 class="page-title" data-i18n="page.resume.title">Hồ sơ</h2>
		<div class="page-accent"></div>
	</section>

	<section class="resume-block">
		<h3 class="block-title">Học vấn</h3>
		<div class="timeline-list">
			{education.map((item) => (
				<article class="timeline-item">
					<div class="timeline-dot"></div>
					<div class="timeline-copy">
						<h4>{item.title}</h4>
						<span>{item.time}</span>
						<p>{item.body}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="resume-block">
		<h3 class="block-title">Kinh nghiệm</h3>
		<div class="timeline-list">
			{experience.map((item) => (
				<article class="timeline-item">
					<div class="timeline-dot"></div>
					<div class="timeline-copy">
						<h4>{item.title}</h4>
						<span>{item.time}</span>
						<p>{item.body}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="resume-block">
		<h3 class="block-title">Kỹ năng chính</h3>
		<div class="skills-grid">
			{skills.map((skill) => (
				<article class="skill-card">
					<div class="skill-icon">
						{
							skill.icon === 'linux' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 6.5c0-1.9 1.1-3.5 2.5-3.5s2.5 1.6 2.5 3.5c0 1-.3 1.9-.8 2.5.7.7 1.3 1.8 1.3 3 0 2.4-1.4 4.5-3 4.5s-3-2.1-3-4.5c0-1.2.5-2.3 1.3-3-.5-.6-.8-1.5-.8-2.5Z" stroke="currentColor" stroke-width="1.7"/><path d="M8 20c.5-1.8 2.1-3 4-3s3.5 1.2 4 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
							) : skill.icon === 'docker' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10h3v3H4zm4 0h3v3H8zm4 0h3v3h-3zm-6-4h3v3H6zm4 0h3v3h-3zm4 4h3c1.2 0 2.1-.3 2.7-.8.3 2.7-1.4 5.8-5.5 5.8H9.2C6.4 15 4 12.9 4 10h14Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
							) : skill.icon === 'cloud' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 18H7a4 4 0 1 1 .7-7.9A5.5 5.5 0 0 1 18.4 8 3.5 3.5 0 1 1 19 18Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
							) : skill.icon === 'nginx' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 7 4v10l-7 4-7-4V7l7-4Z" stroke="currentColor" stroke-width="1.7"/><path d="M9 15V9l6 6V9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
							) : skill.icon === 'code' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-8-2 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
							) : skill.icon === 'python' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 4h4a3 3 0 0 1 3 3v2H9a2 2 0 0 0-2 2v2H5a3 3 0 0 1-3-3V9a5 5 0 0 1 5-5h2Zm6 16h-4a3 3 0 0 1-3-3v-2h7a2 2 0 0 0 2-2v-2h2a3 3 0 0 1 3 3v1a5 5 0 0 1-5 5h-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
							) : skill.icon === 'ci' ? (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h6l2-6 3 12 2-6h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
							) : (
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5.5 6v5.5c0 4.2 2.8 8 6.5 9.5 3.7-1.5 6.5-5.3 6.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9.5 12.5 11 14l3.5-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
							)
						}
					</div>
					<div>
						<h4>{skill.title}</h4>
						<p>{skill.note}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<style>
		.page-title {
			font-size: clamp(2.2rem, 4vw, 3.4rem);
		}

		.page-accent {
			width: 58px;
			height: 4px;
			margin-top: 0.9rem;
			border-radius: 999px;
			background: #17b8ff;
		}

		.resume-block {
			margin-top: 2rem;
		}

		.block-title {
			font-size: 1.9rem;
			margin-bottom: 1rem;
		}

		.timeline-list {
			display: grid;
			gap: 1rem;
		}

		.timeline-item {
			display: grid;
			grid-template-columns: 22px minmax(0, 1fr);
			gap: 1rem;
			padding-left: 0.15rem;
		}

		.timeline-dot {
			width: 14px;
			height: 14px;
			margin-top: 0.4rem;
			border-radius: 999px;
			background: #15bfff;
		}

		.timeline-copy {
			padding-left: 1rem;
			border-left: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 1.2rem;
		}

		.timeline-copy h4 {
			font-size: 1.35rem;
			margin-bottom: 0.35rem;
		}

		.timeline-copy span {
			display: inline-block;
			margin-bottom: 0.55rem;
			color: #19c9ff;
			font-weight: 700;
		}

		.timeline-copy p {
			color: #b6c4d3;
			line-height: 1.85;
		}

		.skills-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem;
		}

		.skill-card {
			display: grid;
			grid-template-columns: 56px minmax(0, 1fr);
			gap: 1rem;
			padding: 1.15rem;
			border-radius: 1.2rem;
			border: 1px solid rgba(216, 190, 154, 0.4);
			background: rgba(255, 255, 255, 0.03);
		}

		.skill-icon {
			color: #19c9ff;
		}

		.skill-card h4 {
			font-size: 1.18rem;
			margin-bottom: 0.3rem;
		}

		.skill-card p {
			color: #b6c4d3;
			line-height: 1.7;
		}

		@media (max-width: 900px) {
			.skills-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</ProfileShell>
