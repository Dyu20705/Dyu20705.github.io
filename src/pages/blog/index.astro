---
import { getCollection } from 'astro:content';
import ProfileShell from '../../layouts/ProfileShell.astro';
import { blogCardMeta, sharedCover } from '../../data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<ProfileShell
	headTitle="Blog | Nguyễn Văn Duy"
	description="Các bài viết về system, infrastructure, security và vận hành thực tế."
	activeNav="blog"
>
	<section>
		<h2 class="page-title" data-i18n="page.blog.title">Blog</h2>
		<div class="page-accent"></div>
	</section>

	<section class="blog-grid">
		{posts.map((post) => {
			const meta = blogCardMeta[post.id] ?? { tag: 'System', readTime: '3 phút' };
			return (
				<a class="blog-card" href={`/blog/${post.id}/`}>
					<img src={sharedCover.src} alt={post.data.title} loading="lazy" />
					<div class="blog-copy">
						<div class="blog-meta">
							<span class="blog-tag">{meta.tag}</span>
							<span>{post.data.pubDate.toLocaleDateString('vi-VN')}</span>
							<span>{meta.readTime}</span>
						</div>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
						<strong>Đọc bài viết</strong>
					</div>
				</a>
			);
		})}
	</section>

	<style>
		.page-title {
			font-size: clamp(2.2rem, 4vw, 3.4rem);
		}

		.page-accent {
			width: 58px;
			height: 4px;
			margin-top: 0.9rem;
			border-radius: 999px;
			background: #17b8ff;
		}

		.blog-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			margin-top: 1.5rem;
		}

		.blog-card {
			overflow: hidden;
			text-decoration: none;
			border-radius: 1.2rem;
			border: 1px solid rgba(216, 190, 154, 0.35);
			background: rgba(255, 255, 255, 0.03);
		}

		.blog-card img {
			width: 100%;
			height: 220px;
			object-fit: cover;
			border-radius: 0;
		}

		.blog-copy {
			padding: 1rem;
		}

		.blog-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
			margin-bottom: 0.75rem;
			font-size: 0.86rem;
			color: #98a8b8;
		}

		.blog-tag {
			padding: 0.18rem 0.55rem;
			border-radius: 999px;
			background: rgba(12, 187, 255, 0.12);
			color: #19c9ff;
			font-weight: 700;
		}

		.blog-copy h3 {
			font-size: 1.35rem;
			margin-bottom: 0.55rem;
		}

		.blog-copy p {
			color: #b8c5d2;
			line-height: 1.78;
			margin-bottom: 0.85rem;
		}

		.blog-copy strong {
			color: #18c6ff;
		}

		@media (max-width: 1100px) {
			.blog-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 900px) {
			.blog-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</ProfileShell>
