---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-archive {
				display: grid;
				gap: 1rem;
				margin-bottom: 1.25rem;
				padding: 1.5rem;
				border: 1px solid var(--line);
				border-radius: var(--radius-lg);
				background: var(--bg-elevated);
				box-shadow: var(--shadow-xl);
			}

			.featured-post {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
				gap: 1rem;
				align-items: center;
				padding-top: 1rem;
				border-top: 1px solid var(--line);
			}

			.featured-post img {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border: 1px solid var(--line);
				box-shadow: var(--shadow-lg);
			}

			.archive-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.archive-card img {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				margin-bottom: 0.85rem;
				border: 1px solid var(--line);
			}

			.archive-card h3 {
				font-size: 1.25rem;
			}

			@media (max-width: 1024px) {
				.featured-post,
				.archive-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-archive">
				<p class="eyebrow">Writing archive</p>
				<h1>Notes on systems, delivery discipline, and maintainable product engineering.</h1>
				<p class="section-lead">
					This archive exists to show how I think: what I notice, what I optimize for, and how I reduce
					risk when engineering work has to survive contact with production.
				</p>
				{posts[0] && (
					<a class="archive-card featured-post" href={`/blog/${posts[0].id}/`}>
						<div>
							<p class="meta">Featured note</p>
							<h3>{posts[0].data.title}</h3>
							<p>{posts[0].data.description}</p>
							<footer>
								<FormattedDate date={posts[0].data.pubDate} />
							</footer>
						</div>
						{posts[0].data.heroImage && <Image width={960} height={540} src={posts[0].data.heroImage} alt="" />}
					</a>
				)}
			</section>

			<section class="section">
				<div class="section-heading">
					<p class="eyebrow">All posts</p>
					<h2>Recent writing</h2>
				</div>
				<ul class="archive-list">
					{
						posts.map((post) => (
							<li>
								<a class="archive-card" href={`/blog/${post.id}/`}>
									{post.data.heroImage && <Image width={720} height={360} src={post.data.heroImage} alt="" />}
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>