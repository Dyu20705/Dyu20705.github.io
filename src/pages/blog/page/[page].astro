---
import BlogPage from '../../../components/BlogPage.astro';
import { publishedPosts, POSTS_PER_PAGE } from '../../../data/content';
export async function getStaticPaths() {
  const all = await publishedPosts();
  const pages = Math.ceil(all.length / POSTS_PER_PAGE);
  return Array.from({length: Math.max(0, pages - 1)}, (_, i) => ({params:{page:String(i+2)},props:{posts:all.slice((i+1)*POSTS_PER_PAGE,(i+2)*POSTS_PER_PAGE),page:i+2,pages}}));
}
---
<BlogPage {...Astro.props} />
