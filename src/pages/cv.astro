---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
const cvFile = '/cv/NguyenVanDuy_CV.pdf';
---
<!doctype html>
<html lang="vi">
  <head>
    <BaseHead title="CV — Duy" />
  </head>
  <body>
    <Header />
    <main style="width:min(1100px,calc(100% - 2rem));margin:2rem auto;">
      <section class="section-panel">
        <h2 class="section-title" data-i18n="section.cv.title">CV</h2>
        <iframe class="cv-frame" src={cvFile} title="Nguyen Van Duy CV" style="width:100%;height:700px;border:0;margin-top:1rem;"></iframe>
        <div class="cv-actions" style="margin-top:0.8rem;display:flex;gap:0.8rem;">
          <a href={cvFile} target="_blank" rel="noreferrer">Mở CV tab mới</a>
          <a href={cvFile} download="NguyenVanDuy_CV.pdf">Tải CV</a>
        </div>
      </section>
    </main>
  </body>
</html>
