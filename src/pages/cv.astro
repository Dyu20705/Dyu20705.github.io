---
import ProfileShell from '../layouts/ProfileShell.astro';

const cvFile = '/cv/NguyenVanDuy_CV.pdf';
---

<ProfileShell
	headTitle="CV | Nguyễn Văn Duy"
	description="Trang xem và tải CV của Nguyễn Văn Duy."
	activeNav="cv"
>
	<section>
		<h2 class="page-title" data-i18n="page.cv.title">CV</h2>
		<div class="page-accent"></div>
	</section>

	<section class="cv-panel">
		<iframe class="cv-frame" src={cvFile} title="CV Nguyễn Văn Duy" loading="lazy"></iframe>
		<div class="cv-actions">
			<a href={cvFile} target="_blank" rel="noreferrer" data-i18n="cv.open">Mở ở tab mới</a>
			<a href={cvFile} download="NguyenVanDuy_CV.pdf" data-i18n="cv.download">Tải xuống</a>
		</div>
	</section>

	<style>
		.page-title {
			font-size: clamp(2.2rem, 4vw, 3.4rem);
		}

		.page-accent {
			width: 58px;
			height: 4px;
			margin-top: 0.9rem;
			border-radius: 999px;
			background: #17b8ff;
		}

		.cv-panel {
			margin-top: 1.5rem;
		}

		.cv-frame {
			width: 100%;
			height: 780px;
			border: 1px solid rgba(216, 190, 154, 0.35);
			border-radius: 1.2rem;
			background: #ffffff;
		}

		.cv-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.8rem;
			margin-top: 1rem;
		}

		.cv-actions a {
			padding: 0.85rem 1.15rem;
			border-radius: 0.95rem;
			text-decoration: none;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid rgba(216, 190, 154, 0.35);
		}
	</style>
</ProfileShell>
