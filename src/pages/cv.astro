---
import SiteLayout from '../layouts/SiteLayout.astro';
import Copy from '../components/Copy.astro';
const cvFile = '/cv/NguyenVanDuy_CV.pdf';
---
<SiteLayout activeNav="cv" title={{vi:'CV PDF | Nguyễn Văn Duy',en:'PDF CV | Nguyễn Văn Duy'}} description={{vi:'Xem và tải CV PDF của Nguyễn Văn Duy.',en:'View and download Nguyễn Văn Duy’s PDF CV.'}}>
  <div class="page-intro"><p class="eyebrow"><Copy vi="Tài liệu PDF" en="PDF document" /></p><h1>CV</h1><p><Copy vi="CV là tài liệu PDF có thể xem và tải xuống. Resume là hồ sơ HTML trên website." en="The CV is a PDF document you can view and download. Resume is the HTML profile on this website." /></p><div class="link-row"><a href={cvFile} target="_blank" rel="noopener noreferrer"><Copy vi="Mở PDF ở tab mới" en="Open PDF in a new tab" /> <span aria-hidden="true">↗</span></a><a href={cvFile} download="NguyenVanDuy_CV.pdf"><Copy vi="Tải PDF" en="Download PDF" /></a><a href="/resume"><Copy vi="Hồ sơ HTML" en="HTML Resume" /></a></div></div>
  <iframe class="cv-frame" src={cvFile} title="CV Nguyễn Văn Duy — PDF" loading="lazy"></iframe>
</SiteLayout>
<style>.cv-frame { width: 100%; height: 780px; border: 1px solid var(--line); border-radius: 4px; background: #fff; } @media(max-width:767px) { .cv-frame { height: 600px; } }</style>
