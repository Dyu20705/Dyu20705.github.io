---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { sharedCover } from '../data/site';
import ProfileShell from './ProfileShell.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<ProfileShell headTitle={title} description={description} activeNav="blog">
	<div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
	<article class="article-shell">
		<a class="post-backlink" href="/blog" data-i18n="blog.back">← Quay lại blog</a>
		<div class="hero-image">
			<Image width={1200} height={630} src={sharedCover} alt={title} />
		</div>
		<div class="post-header">
			<p class="eyebrow" data-i18n="blog.eyebrow">Bài viết kỹ thuật</p>
			<h1 class="post-title">{title}</h1>
			<div class="post-meta">
				<span><FormattedDate date={pubDate} /></span>
				{
					updatedDate && (
						<span>
							Cập nhật <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</div>
		</div>
		<div class="prose">
			<slot />
		</div>
	</article>

	<script is:inline>
		(function () {
			const bar = document.getElementById('reading-progress-bar');
			const article = document.querySelector('.article-shell');
			if (!bar || !article) return;
			let frame = 0;
			const update = () => {
				frame = 0;
				const rect = article.getBoundingClientRect();
				const total = rect.height - window.innerHeight;
				const read = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
				bar.style.transform = `scaleX(${total <= 0 ? 1 : read / total})`;
			};
			const request = () => {
				if (frame) return;
				frame = requestAnimationFrame(update);
			};
			update();
			window.addEventListener('scroll', request, { passive: true });
			window.addEventListener('resize', request);
			window.addEventListener('pagehide', () => {
				window.removeEventListener('scroll', request);
				window.removeEventListener('resize', request);
				if (frame) cancelAnimationFrame(frame);
			}, { once: true });
		})();
	</script>

	<style>
		.reading-progress {
			position: sticky;
			top: 0;
			z-index: 20;
			height: 3px;
			margin: -1.5rem -1.5rem 1.2rem;
			background: rgba(255, 255, 255, 0.06);
			transform-origin: left;
		}

		.reading-progress span {
			display: block;
			width: 100%;
			height: 100%;
			background: linear-gradient(90deg, #61d5ff, #d8c0a1);
			transform: scaleX(0);
			transform-origin: left;
		}

		.article-shell {
			max-width: 860px;
		}

		.post-backlink {
			display: inline-flex;
			margin-bottom: 1rem;
			color: #19c9ff;
			text-decoration: none;
		}

		.hero-image img {
			width: 100%;
			height: auto;
			border-radius: 1.2rem;
		}

		.post-header {
			display: grid;
			gap: 0.8rem;
			margin: 1.25rem 0;
			padding-bottom: 1rem;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		}

		.post-title {
			font-size: clamp(2.2rem, 4vw, 3.5rem);
		}

		.post-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.8rem;
			color: #9badbf;
			font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
			font-size: 0.86rem;
		}

		.prose :global(h2),
		.prose :global(h3) {
			margin-top: 1.8rem;
			margin-bottom: 0.7rem;
		}

		.prose :global(p),
		.prose :global(li) {
			color: #b8c5d2;
			line-height: 1.9;
		}

		.prose :global(p + p),
		.prose :global(p + ul),
		.prose :global(p + ol),
		.prose :global(ul + p),
		.prose :global(ol + p) {
			margin-top: 1rem;
		}
	</style>
</ProfileShell>
