---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { sharedCover } from '../data/site';
import ProfileShell from './ProfileShell.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<ProfileShell headTitle={title} description={description} activeNav="blog">
	<article class="article-shell">
		<a class="post-backlink" href="/blog" data-i18n="blog.back">← Quay lại blog</a>
		<div class="hero-image">
			<Image width={1200} height={630} src={sharedCover} alt={title} />
		</div>
		<div class="post-header">
			<p class="eyebrow" data-i18n="blog.eyebrow">Bài viết kỹ thuật</p>
			<h1 class="post-title">{title}</h1>
			<div class="post-meta">
				<span><FormattedDate date={pubDate} /></span>
				{
					updatedDate && (
						<span>
							Cập nhật <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</div>
		</div>
		<div class="prose">
			<slot />
		</div>
	</article>

	<style>
		.article-shell {
			max-width: 860px;
		}

		.post-backlink {
			display: inline-flex;
			margin-bottom: 1rem;
			color: #19c9ff;
			text-decoration: none;
		}

		.hero-image img {
			width: 100%;
			height: auto;
			border-radius: 1.2rem;
		}

		.post-header {
			display: grid;
			gap: 0.8rem;
			margin: 1.25rem 0;
		}

		.post-title {
			font-size: clamp(2.2rem, 4vw, 3.5rem);
		}

		.post-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.8rem;
			color: #9badbf;
		}

		.prose :global(h2),
		.prose :global(h3) {
			margin-top: 1.8rem;
			margin-bottom: 0.7rem;
		}

		.prose :global(p),
		.prose :global(li) {
			color: #b8c5d2;
			line-height: 1.9;
		}

		.prose :global(p + p),
		.prose :global(p + ul),
		.prose :global(p + ol),
		.prose :global(ul + p),
		.prose :global(ol + p) {
			margin-top: 1rem;
		}
	</style>
</ProfileShell>
