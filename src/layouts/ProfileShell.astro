---
import BaseHead from '../components/BaseHead.astro';
import { profile, navItems, socialLinks } from '../data/site';
import { Image } from 'astro:assets';

interface Props {
	headTitle: string;
	description: string;
	activeNav: string;
}

const { headTitle, description, activeNav } = Astro.props;

const navMeta: Record<string, { index: string; system: string }> = {
	about: { index: '01', system: 'Identity' },
	resume: { index: '02', system: 'Evidence' },
	portfolio: { index: '03', system: 'Systems' },
	blog: { index: '04', system: 'Engineering Log' },
	contact: { index: '05', system: 'Open Channel' },
	gallery: { index: '06', system: 'Archive' },
	cv: { index: '07', system: 'Resume File' },
};
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={headTitle} description={description} />
		<style>
			.shell {
				width: min(1360px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 5.2rem 0 3rem;
				display: grid;
				grid-template-columns: 270px minmax(0, 1fr);
				gap: 1.2rem;
				align-items: start;
				position: relative;
				z-index: 1;
			}

			.control-room-bg {
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background:
					radial-gradient(circle at var(--pointer-x, 72%) var(--pointer-y, 18%), rgba(42, 220, 255, 0.16), transparent 22rem),
					linear-gradient(115deg, rgba(41, 121, 255, 0.08), transparent 38%),
					linear-gradient(180deg, #050912 0%, #08111d 48%, #04070d 100%);
			}

			.control-room-bg::before,
			.control-room-bg::after {
				content: '';
				position: absolute;
				inset: 0;
			}

			.control-room-bg::before {
				background-image:
					linear-gradient(rgba(97, 213, 255, 0.06) 1px, transparent 1px),
					linear-gradient(90deg, rgba(97, 213, 255, 0.045) 1px, transparent 1px),
					radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
				background-size: 42px 42px, 42px 42px, 86px 86px;
				mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.88), transparent 92%);
				opacity: 0.72;
			}

			.control-room-bg::after {
				background:
					linear-gradient(90deg, transparent, rgba(97, 213, 255, 0.08), transparent),
					linear-gradient(135deg, transparent 0 45%, rgba(255, 190, 96, 0.08) 46% 47%, transparent 48%);
				background-size: 28rem 100%, 34rem 34rem;
				animation: data-flow 18s linear infinite;
				opacity: 0.42;
			}

			@keyframes data-flow {
				from {
					background-position: -28rem 0, 0 0;
				}
				to {
					background-position: 100vw 0, 34rem 34rem;
				}
			}

			.sidebar,
			.content-panel {
				border: 1px solid var(--line);
				border-radius: 1.25rem;
				background:
					linear-gradient(145deg, rgba(16, 27, 42, 0.96), rgba(7, 12, 22, 0.94)),
					rgba(12, 16, 24, 0.94);
				box-shadow: 0 24px 44px rgba(0, 0, 0, 0.28);
				backdrop-filter: blur(14px);
			}

			.sidebar {
				position: sticky;
				top: 1.3rem;
				padding: 1.25rem;
			}

			.profile-photo {
				display: block;
				width: 112px;
				height: 112px;
				margin: 0 auto;
				border-radius: 1.5rem;
				object-fit: cover;
				object-position: center top;
				border: 1px solid rgba(255, 255, 255, 0.08);
				box-shadow: 0 0 0 7px rgba(25, 201, 255, 0.04), 0 18px 32px rgba(0, 0, 0, 0.28);
			}

			.profile-name {
				margin-top: 1rem;
				font-size: 2rem;
				text-align: center;
			}

			.profile-role {
				display: inline-flex;
				justify-content: center;
				margin: 0.7rem auto 0;
				padding: 0.38rem 0.9rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.05);
				color: #d7e6f6;
				font-size: 0.82rem;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				letter-spacing: 0.04em;
			}

			.profile-role-wrap {
				display: flex;
				justify-content: center;
			}

			.sidebar-line {
				height: 1px;
				margin: 1.25rem 0;
				background: rgba(255, 255, 255, 0.08);
			}

			.contact-list {
				display: grid;
				gap: 0.9rem;
			}

			.contact-item {
				display: grid;
				grid-template-columns: 44px minmax(0, 1fr);
				gap: 0.75rem;
				align-items: center;
			}

			.contact-icon {
				width: 44px;
				height: 44px;
				border-radius: 0.95rem;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(255, 255, 255, 0.04);
				color: #19c9ff;
			}

			.contact-copy small {
				display: block;
				margin-bottom: 0.18rem;
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-muted);
			}

			.contact-copy a,
			.contact-copy span {
				color: var(--text-strong);
				text-decoration: none;
				font-size: 0.96rem;
			}

			.email-row {
				display: flex;
				gap: 0.45rem;
				align-items: center;
				min-width: 0;
			}

			.email-row a {
				min-width: 0;
				overflow-wrap: anywhere;
			}

			.copy-email {
				flex: 0 0 auto;
				padding: 0.2rem 0.45rem;
				border: 1px solid rgba(97, 213, 255, 0.18);
				border-radius: 999px;
				background: rgba(97, 213, 255, 0.08);
				color: #61d5ff;
				font: inherit;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.66rem;
				cursor: pointer;
			}

			.copy-email:hover,
			.copy-email:focus-visible {
				background: rgba(97, 213, 255, 0.14);
				border-color: rgba(97, 213, 255, 0.36);
			}

			.sidebar-socials {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
			}

			.sidebar-socials a {
				width: 42px;
				height: 42px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border-radius: 0.9rem;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid transparent;
				color: var(--text-strong);
				transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, color 180ms ease;
			}

			.social-icon {
				display: block;
				flex: 0 0 auto;
			}

			.social-icon-leetcode {
				transform: translateX(1px);
			}

			.sidebar-socials a:hover,
			.sidebar-socials a:focus-visible {
				transform: translateY(-2px);
				border-color: rgba(25, 201, 255, 0.28);
				background: rgba(255, 255, 255, 0.06);
				color: #7ce8ff;
			}

			.content-panel {
				overflow: hidden;
			}

			.top-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				padding: 1rem 1.25rem;
				border-bottom: 1px solid var(--line);
				background: linear-gradient(90deg, rgba(97, 213, 255, 0.05), transparent);
			}

			.top-nav a {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr);
				column-gap: 0.55rem;
				row-gap: 0.08rem;
				min-width: 8.8rem;
				padding: 0.62rem 0.86rem;
				border-radius: 0.9rem;
				color: #d0b694;
				text-decoration: none;
				font-size: 0.9rem;
				transition: transform 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease;
				border: 1px solid transparent;
			}

			.top-nav a:hover,
			.top-nav a:focus-visible {
				transform: translateY(-1px);
				border-color: rgba(97, 213, 255, 0.18);
				background: rgba(255, 255, 255, 0.04);
			}

			.top-nav a.is-active {
				background: linear-gradient(135deg, rgba(18, 62, 104, 0.78), rgba(24, 201, 255, 0.12));
				color: #ffffff;
				font-weight: 700;
				border-color: rgba(97, 213, 255, 0.28);
			}

			.nav-index {
				grid-row: span 2;
				align-self: center;
				color: #61d5ff;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.72rem;
			}

			.nav-system {
				color: var(--text-muted);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.66rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.page-body {
				padding: 1.5rem;
			}

			.control-cluster {
				position: fixed;
				top: 16px;
				right: 18px;
				z-index: 80;
				display: flex;
				gap: 0.5rem;
				align-items: center;
				padding: 0.42rem;
				border-radius: 999px;
				border: 1px solid rgba(255, 255, 255, 0.12);
				background: rgba(14, 18, 26, 0.94);
				box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28);
				backdrop-filter: blur(16px);
			}

			.control-button {
				min-width: 46px;
				min-height: 38px;
				padding: 0.42rem 0.72rem;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.04);
				color: var(--text-strong);
				font: inherit;
				font-size: 0.82rem;
				font-weight: 700;
				cursor: pointer;
				transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
			}

			.control-button:hover,
			.control-button:focus-visible,
			.control-button[aria-pressed='true'] {
				transform: translateY(-1px);
				border-color: rgba(97, 213, 255, 0.32);
				background: rgba(97, 213, 255, 0.12);
			}

			.control-button kbd {
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.74rem;
			}

			.command-dialog[hidden] {
				display: none;
			}

			.command-dialog {
				position: fixed;
				inset: 0;
				z-index: 120;
				display: grid;
				place-items: start center;
				padding: 7vh 1rem 1rem;
				background: rgba(2, 6, 12, 0.68);
				backdrop-filter: blur(10px);
			}

			.command-panel {
				width: min(720px, 100%);
				overflow: hidden;
				border: 1px solid rgba(97, 213, 255, 0.24);
				border-radius: 1.1rem;
				background:
					linear-gradient(145deg, rgba(16, 30, 48, 0.98), rgba(6, 10, 18, 0.98)),
					#090f18;
				box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
			}

			.command-header {
				display: grid;
				gap: 0.5rem;
				padding: 1rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}

			.command-header label {
				color: #61d5ff;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			.command-input {
				width: 100%;
				padding: 0.95rem 1rem;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 0.85rem;
				background: rgba(255, 255, 255, 0.04);
				color: var(--text-strong);
				font: inherit;
			}

			.command-list {
				display: grid;
				gap: 0.45rem;
				max-height: min(58vh, 520px);
				overflow-y: auto;
				padding: 0.8rem;
			}

			.command-group {
				margin: 0.35rem 0 0.05rem;
				color: #61d5ff;
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.68rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.command-empty[hidden] {
				display: none;
			}

			.command-empty {
				padding: 1rem;
				color: var(--text-muted);
				font-size: 0.94rem;
			}

			.command-item {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 0.75rem;
				align-items: center;
				width: 100%;
				padding: 0.82rem 0.9rem;
				border: 1px solid transparent;
				border-radius: 0.85rem;
				background: transparent;
				color: var(--text-strong);
				font: inherit;
				text-align: left;
				cursor: pointer;
			}

			.command-item:hover,
			.command-item:focus-visible,
			.command-item.is-active {
				border-color: rgba(97, 213, 255, 0.24);
				background: rgba(97, 213, 255, 0.08);
			}

			.command-item small,
			.command-shortcut {
				color: var(--text-muted);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.76rem;
			}

			.command-status {
				display: none;
				padding: 0.9rem 1rem 1rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				color: #d7e6f6;
				white-space: pre-wrap;
			}

			.command-status.is-visible {
				display: block;
			}

			[data-reveal] {
				opacity: 0;
				transform: translateY(18px);
				transition: opacity 420ms ease, transform 420ms ease, filter 420ms ease;
				filter: blur(3px);
			}

			[data-reveal].is-visible {
				opacity: 1;
				transform: translateY(0);
				filter: blur(0);
			}

			.sound-toast {
				position: fixed;
				left: 50%;
				bottom: 18px;
				z-index: 140;
				padding: 0.7rem 0.9rem;
				border: 1px solid rgba(97, 213, 255, 0.24);
				border-radius: 999px;
				background: rgba(9, 15, 24, 0.96);
				color: var(--text-strong);
				font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
				font-size: 0.78rem;
				opacity: 0;
				transform: translate(-50%, 12px);
				pointer-events: none;
				transition: opacity 180ms ease, transform 180ms ease;
			}

			.sound-toast.is-visible {
				opacity: 1;
				transform: translate(-50%, 0);
			}

			:global(body[data-theme='light']) {
				--bg: #f2f7fb;
				--bg-elevated: rgba(255, 255, 255, 0.82);
				--bg-panel: rgba(255, 255, 255, 0.9);
				--text-strong: #091423;
				--text-body: #26384d;
				--text-muted: #617087;
				--line: rgba(28, 76, 112, 0.18);
				color-scheme: light;
			}

			:global(body[data-theme='light']) .sidebar,
			:global(body[data-theme='light']) .content-panel,
			:global(body[data-theme='light']) .control-cluster,
			:global(body[data-theme='light']) .command-panel {
				background: rgba(255, 255, 255, 0.92);
			}

			:global(body.user-reduce-motion) *,
			:global(body.user-reduce-motion) *::before,
			:global(body.user-reduce-motion) *::after {
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.01ms !important;
				scroll-behavior: auto !important;
			}

			@media (max-width: 1080px) {
				.shell {
					grid-template-columns: 1fr;
					padding-top: 5.6rem;
				}

				.sidebar {
					position: static;
				}
			}

			@media (max-width: 720px) {
				.shell {
					width: calc(100% - 1rem);
					padding-top: 5.8rem;
				}

				.page-body {
					padding: 1rem;
				}

				.top-nav {
					padding: 0.85rem;
				}

				.top-nav a {
					padding: 0.6rem 0.82rem;
					font-size: 0.86rem;
					min-width: 7.5rem;
				}

				.control-cluster {
					left: 0.5rem;
					right: 0.5rem;
					justify-content: space-between;
					border-radius: 1rem;
				}

				.control-button {
					min-width: 42px;
					padding-inline: 0.62rem;
				}

				.command-button-label {
					display: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.control-room-bg::after {
					animation: none;
				}

				[data-reveal] {
					opacity: 1;
					transform: none;
					filter: none;
				}
			}
		</style>
	</head>
	<body>
		<div class="control-room-bg" aria-hidden="true"></div>
		<a class="skip-link" href="#page-content" data-i18n="skip.content">Skip to content</a>
		<div class="control-cluster" aria-label="Control room settings">
			<button class="control-button" id="command-open" type="button" aria-label="Open command palette" data-i18n-aria-label="command.open.aria">
				<span class="command-button-label" data-i18n="command.open">Command</span> <kbd>Ctrl K</kbd>
			</button>
			<button class="control-button" id="sound-toggle" type="button" aria-pressed="false" aria-label="Enable sound" data-i18n-aria-label="sound.toggle.aria" data-i18n="sound.off">Sound Off</button>
			<button class="control-button" id="theme-toggle" type="button" aria-pressed="false" aria-label="Toggle theme" data-i18n-aria-label="theme.toggle.aria" data-i18n="theme.dark">Dark</button>
			<button class="control-button" id="motion-toggle" type="button" aria-pressed="false" aria-label="Reduce motion" data-i18n-aria-label="motion.toggle.aria" data-i18n="motion.full">Motion</button>
			<button class="control-button" id="lang-float" type="button" aria-label="Toggle language" data-i18n-aria-label="language.toggle.aria">EN</button>
		</div>
		<main class="shell" id="page-content">
			<aside class="sidebar">
				<Image class="profile-photo" src={profile.photo} alt="Ảnh chân dung Nguyễn Văn Duy" data-i18n-alt="profile.photo.alt" width={112} height={112} loading="eager" decoding="async" />
				<h1 class="profile-name">{profile.name}</h1>
				<div class="profile-role-wrap">
					<span class="profile-role" data-i18n-role>{profile.role}</span>
				</div>

				<div class="sidebar-line"></div>

				<div class="contact-list">
					<div class="contact-item">
						<div class="contact-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11Zm2.2-.5 5.8 5.1L17.8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="contact-copy">
							<small data-i18n="profile.email">Email</small>
							<div class="email-row">
								<a href={`mailto:${profile.email}`}>{profile.email}</a>
								<button class="copy-email" type="button" data-copy-email={profile.email} aria-label="Copy email" data-i18n-aria-label="email.copy.aria" data-i18n="email.copy">Copy</button>
							</div>
						</div>
					</div>
					<div class="contact-item">
						<div class="contact-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20s6-5.6 6-10a6 6 0 1 0-12 0c0 4.4 6 10 6 10Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" stroke="currentColor" stroke-width="1.7"/></svg>
						</div>
						<div class="contact-copy">
							<small data-i18n="profile.location">Địa điểm</small>
							<span>{profile.location}</span>
						</div>
					</div>
				</div>

				<div class="sidebar-line"></div>

				<div class="sidebar-socials">
					{socialLinks.map((item) => (
						<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} title={item.label}>
							{
								item.id === 'github' ? (
									<svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.2.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.2-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1 1.9 1.4 3.5 1 .1-.7.4-1.1.7-1.3-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.4.1-3 0 0 1-.3 3.2 1.2.9-.3 1.9-.4 2.8-.4s1.9.1 2.8.4c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.7.1 3 .7.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.3.8 1 .8 2v2.9c0 .4.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
								) : item.id === 'linkedin' ? (
									<svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.49 2.49 0 1 1 0 3.5a2.49 2.49 0 0 1 4.98 0ZM.5 8.5h4.9V24H.5V8.5Zm7.4 0H12v2.1h.1c.6-1.1 2-2.3 4.2-2.3 4.5 0 5.3 2.9 5.3 6.8V24h-4.9v-6.1c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V24H7.9V8.5Z"/></svg>
								) : (
