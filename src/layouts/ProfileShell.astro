				const button = document.getElementById('lang-float');

				function applyLang(lang) {
					document.querySelectorAll('[data-i18n]').forEach((element) => {
						const key = element.getAttribute('data-i18n');
						if (key && translations[lang] && translations[lang][key]) {
							element.textContent = translations[lang][key];
						}
					});
					document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
						const key = element.getAttribute('data-i18n-placeholder');
						if (key && translations[lang] && translations[lang][key]) {
							element.setAttribute('placeholder', translations[lang][key]);
						}
					});
					document.querySelectorAll('[data-i18n-alt]').forEach((element) => {
						const key = element.getAttribute('data-i18n-alt');
						if (key && translations[lang] && translations[lang][key]) {
							element.setAttribute('alt', translations[lang][key]);
						}
					});
					document.querySelectorAll('[data-i18n-role]').forEach((element) => {
						element.textContent = translations[lang]['role.main'];
					});
					document.documentElement.lang = lang;
					if (button) button.textContent = lang === 'vi' ? 'EN' : 'VI';
					localStorage.setItem('siteLang', lang);
				}

				const currentLang = localStorage.getItem('siteLang') || 'vi';
				applyLang(currentLang);

				if (button) {
					button.addEventListener('click', () => {
						const nextLang = localStorage.getItem('siteLang') === 'vi' ? 'en' : 'vi';
						applyLang(nextLang);
					});
				}
			})();
		</script>
		<script type="module" define:vars={{ entranceSong, goodbyeSong }}>
			const audioState = {
				entrancePlayed: false,
				goodbyePlayed: false,
				activated: false,
			};

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let entranceAudio;
			let goodbyeAudio;

			const ensureAudio = () => {
				if (reducedMotion) return false;
				if (!entranceAudio) {
					entranceAudio = new Audio(entranceSong);
					entranceAudio.preload = 'none';
					entranceAudio.volume = 0.12;
				}
				if (!goodbyeAudio) {
					goodbyeAudio = new Audio(goodbyeSong);
					goodbyeAudio.preload = 'none';
					goodbyeAudio.volume = 0.1;
				}
				return true;
			};

			const tryPlay = (audio) => {
				if (!audio) return;
				audio.currentTime = 0;
				audio.play().catch(() => {});
			};

			const playEntrance = () => {
				if (audioState.entrancePlayed || !ensureAudio()) return;
				audioState.entrancePlayed = true;
				tryPlay(entranceAudio);
			};

			const playGoodbye = () => {
				if (audioState.goodbyePlayed || !audioState.activated || !ensureAudio()) return;
				audioState.goodbyePlayed = true;
				tryPlay(goodbyeAudio);
			};

			const activateAudio = () => {
				if (audioState.activated || reducedMotion) return;
				audioState.activated = true;
				playEntrance();
			};

			if (!reducedMotion) {
				window.addEventListener('pointerdown', activateAudio, { once: true });
				window.addEventListener('keydown', activateAudio, { once: true });
				window.addEventListener('touchstart', activateAudio, { once: true });
				window.addEventListener('focus', activateAudio, { once: true });

				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState === 'visible') {
						activateAudio();
					}
					if (document.visibilityState === 'hidden') {
						playGoodbye();
					}
				});

				window.addEventListener('pagehide', playGoodbye, { capture: true });
			}
		</script>
