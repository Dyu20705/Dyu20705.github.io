				function applyLang(lang) {
					document.querySelectorAll('[data-i18n]').forEach((element) => {
						const key = element.getAttribute('data-i18n');
						if (key && translations[lang] && translations[lang][key]) {
							element.textContent = translations[lang][key];
						}
					});
					document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
						const key = element.getAttribute('data-i18n-placeholder');
						if (key && translations[lang] && translations[lang][key]) {
							element.setAttribute('placeholder', translations[lang][key]);
						}
					});
					document.querySelectorAll('[data-i18n-alt]').forEach((element) => {
						const key = element.getAttribute('data-i18n-alt');
						if (key && translations[lang] && translations[lang][key]) {
							element.setAttribute('alt', translations[lang][key]);
						}
					});
					document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
						const key = element.getAttribute('data-i18n-aria-label');
						if (key && translations[lang] && translations[lang][key]) {
							element.setAttribute('aria-label', translations[lang][key]);
						}
					});
					document.querySelectorAll('[data-i18n-role]').forEach((element) => {
						element.textContent = translations[lang]['role.main'];
					});
					document.documentElement.lang = lang;
					if (button) button.textContent = lang === 'vi' ? 'EN' : 'VI';
					localStorage.setItem('siteLang', lang);
					window.dispatchEvent(new CustomEvent('control-room-lang', { detail: { lang } }));
				}

				const currentLang = localStorage.getItem('siteLang') || 'vi';
				applyLang(currentLang);

				if (button) {
					button.addEventListener('click', () => {
						const nextLang = localStorage.getItem('siteLang') === 'vi' ? 'en' : 'vi';
						applyLang(nextLang);
					});
				}
				window.controlRoomApplyLang = applyLang;
			})();
		</script>
		<script is:inline>
			(function () {
				const root = document.documentElement;
				const body = document.body;
				const soundButton = document.getElementById('sound-toggle');
				const themeButton = document.getElementById('theme-toggle');
				const motionButton = document.getElementById('motion-toggle');
				const commandOpen = document.getElementById('command-open');
				const dialog = document.getElementById('command-dialog');
				const input = document.getElementById('command-input');
				const list = document.getElementById('command-list');
				const statusBlock = document.getElementById('command-status');
				const commandEmpty = document.getElementById('command-empty');
				const toast = document.getElementById('sound-toast');
				const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
				const isTouch = window.matchMedia('(pointer: coarse)').matches;
				let lastFocus = null;
				let audioContext = null;
				let soundEnabled = localStorage.getItem('controlRoomSound') === 'on';
				let motionReduced = localStorage.getItem('controlRoomMotion') === 'reduced' || reduceQuery.matches;
				let currentTheme = localStorage.getItem('controlRoomTheme') || 'dark';
				let pointerFrame = 0;
				let lastTone = 0;

				const t = (key) => {
					const lang = localStorage.getItem('siteLang') || 'vi';
					return window.controlRoomTranslations?.[lang]?.[key] || key;
				};

				function showToast(message) {
					if (!toast) return;
					toast.textContent = message;
					toast.classList.add('is-visible');
					window.clearTimeout(showToast.timer);
					showToast.timer = window.setTimeout(() => toast.classList.remove('is-visible'), 1400);
				}

				function tone(kind) {
					if (!soundEnabled || document.visibilityState !== 'visible') return;
					const now = performance.now();
					if (now - lastTone < 120) return;
					lastTone = now;
					try {
						audioContext ||= new (window.AudioContext || window.webkitAudioContext)();
						if (audioContext.state === 'suspended') audioContext.resume();
						const osc = audioContext.createOscillator();
						const gain = audioContext.createGain();
						const start = audioContext.currentTime;
						const tones = {
							enable: [560, 760, 0.18],
							nav: [420, 540, 0.12],
							command: [680, 460, 0.16],
							project: [520, 660, 0.14],
							success: [740, 920, 0.18],
						};
						const [from, to, duration] = tones[kind] || tones.nav;
						osc.type = 'sine';
						osc.frequency.setValueAtTime(from, start);
						osc.frequency.exponentialRampToValueAtTime(to, start + duration);
						gain.gain.setValueAtTime(0.0001, start);
						gain.gain.exponentialRampToValueAtTime(0.035, start + 0.025);
						gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
						osc.connect(gain);
						gain.connect(audioContext.destination);
						osc.start(start);
						osc.stop(start + duration + 0.02);
					} catch (_) {}
				}

				function refreshControls() {
					if (soundButton) {
						soundButton.textContent = t(soundEnabled ? 'sound.on' : 'sound.off');
						soundButton.setAttribute('aria-pressed', String(soundEnabled));
					}
					body.dataset.theme = currentTheme;
					if (themeButton) {
						themeButton.textContent = t(currentTheme === 'light' ? 'theme.light' : 'theme.dark');
						themeButton.setAttribute('aria-pressed', String(currentTheme === 'light'));
					}
					body.classList.toggle('user-reduce-motion', motionReduced);
					if (motionButton) {
						motionButton.textContent = t(motionReduced ? 'motion.reduced' : 'motion.full');
						motionButton.setAttribute('aria-pressed', String(motionReduced));
					}
				}

				function setSound(next) {
					soundEnabled = next;
					localStorage.setItem('controlRoomSound', next ? 'on' : 'off');
					refreshControls();
					showToast(t(next ? 'sound.enabled' : 'sound.disabled'));
					if (next) tone('enable');
				}

				function toggleTheme() {
					currentTheme = currentTheme === 'light' ? 'dark' : 'light';
					localStorage.setItem('controlRoomTheme', currentTheme);
					refreshControls();
					tone('success');
				}

				function toggleMotion() {
					motionReduced = !motionReduced;
					localStorage.setItem('controlRoomMotion', motionReduced ? 'reduced' : 'full');
					refreshControls();
					tone('success');
				}

				function openDialog() {
					if (!dialog || !input) return;
					lastFocus = document.activeElement;
					dialog.hidden = false;
					input.value = '';
					filterCommands('');
					statusBlock?.classList.remove('is-visible');
					window.setTimeout(() => input.focus(), 0);
					tone('command');
				}

				function closeDialog() {
					if (!dialog) return;
					dialog.hidden = true;
					if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
				}

				function commandItems() {
					return Array.from(list?.querySelectorAll('.command-item') || []);
				}

				function visibleCommands() {
					return commandItems().filter((item) => !item.hidden);
				}

				function setActiveCommand(next) {
					const items = visibleCommands();
					items.forEach((item) => item.classList.remove('is-active'));
					if (!items.length) return;
					const target = items[Math.max(0, Math.min(next, items.length - 1))];
					target.classList.add('is-active');
					target.scrollIntoView({ block: 'nearest' });
				}

				function filterCommands(query) {
					const value = query.trim().toLowerCase();
					commandItems().forEach((item) => {
						const text = `${item.textContent || ''} ${item.dataset.keywords || ''}`.toLowerCase();
						item.hidden = value && !text.includes(value);
					});
					document.querySelectorAll('.command-group').forEach((group) => {
						let sibling = group.nextElementSibling;
						let hasVisible = false;
						while (sibling && !sibling.classList.contains('command-group')) {
							if (sibling.classList.contains('command-item') && !sibling.hidden) hasVisible = true;
							sibling = sibling.nextElementSibling;
						}
						group.hidden = !hasVisible;
					});
					if (commandEmpty) commandEmpty.hidden = visibleCommands().length > 0;
					setActiveCommand(0);
					if (value === 'status' || value === 'help') showStatus();
				}

				function showStatus() {
					if (!statusBlock) return;
					statusBlock.textContent = t('status.block');
					statusBlock.classList.add('is-visible');
					tone('success');
				}

				function executeCommand(command) {
					if (!command) return;
					if (command.startsWith('goto:')) {
						tone('nav');
						window.location.href = command.replace('goto:', '');
						return;
					}
					if (command === 'external:github') window.open('https://github.com/Dyu20705', '_blank', 'noopener,noreferrer');
					if (command === 'external:linkedin') window.open('https://www.linkedin.com/in/duynguyenvan05/', '_blank', 'noopener,noreferrer');
					if (command === 'toggle:language') document.getElementById('lang-float')?.click();
					if (command === 'toggle:theme') toggleTheme();
					if (command === 'toggle:sound') setSound(!soundEnabled);
					if (command === 'status') {
						showStatus();
						return;
					}
					closeDialog();
				}

				soundButton?.addEventListener('click', () => setSound(!soundEnabled));
				themeButton?.addEventListener('click', toggleTheme);
				motionButton?.addEventListener('click', toggleMotion);
				commandOpen?.addEventListener('click', openDialog);
				input?.addEventListener('input', () => filterCommands(input.value));
				list?.addEventListener('click', (event) => {
					const button = event.target.closest('.command-item');
					if (button) executeCommand(button.dataset.command);
				});

				document.addEventListener('keydown', (event) => {
					const active = document.activeElement;
					const isTyping = active && (active.matches('input, textarea, [contenteditable="true"]'));
					const isCommand = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k' && !isTyping;
					if (isCommand) {
						event.preventDefault();
						openDialog();
					}
					if (!dialog || dialog.hidden) return;
					if (event.key === 'Escape') {
						event.preventDefault();
						closeDialog();
					}
					if (event.key === 'Tab') {
						const focusables = Array.from(dialog.querySelectorAll('button, input')).filter((item) => !item.disabled && !item.hidden);
						const first = focusables[0];
						const last = focusables[focusables.length - 1];
						if (!first || !last) return;
						if (event.shiftKey && document.activeElement === first) {
							event.preventDefault();
							last.focus();
						} else if (!event.shiftKey && document.activeElement === last) {
							event.preventDefault();
							first.focus();
						}
					}
					if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
						event.preventDefault();
						const items = visibleCommands();
						if (!items.length) return;
						const current = Math.max(0, items.findIndex((item) => item.classList.contains('is-active')));
						const next = event.key === 'ArrowDown' ? (current + 1) % items.length : (current - 1 + items.length) % items.length;
						setActiveCommand(next);
					}
					if (event.key === 'Enter' && document.activeElement === input) {
						event.preventDefault();
						const activeItem = visibleCommands().find((item) => item.classList.contains('is-active')) || visibleCommands()[0];
						if (activeItem) executeCommand(activeItem.dataset.command);
					}
				});

				dialog?.addEventListener('click', (event) => {
					if (event.target === dialog) closeDialog();
				});

				document.querySelectorAll('.top-nav a, .portfolio-card, .blog-card').forEach((item) => {
					item.addEventListener('click', () => tone(item.classList.contains('portfolio-card') ? 'project' : 'nav'));
				});

				document.querySelectorAll('[data-copy-email]').forEach((button) => {
					button.addEventListener('click', async () => {
						const email = button.getAttribute('data-copy-email');
						if (!email) return;
						try {
							await navigator.clipboard.writeText(email);
							showToast(t('email.copied'));
							tone('success');
						} catch (_) {
							window.location.href = `mailto:${email}`;
						}
					});
				});

				if ('IntersectionObserver' in window && !motionReduced) {
					const revealTargets = document.querySelectorAll('.page-body section, .service-card, .portfolio-card, .blog-card, .timeline-item, .skill-card, .contact-card');
					revealTargets.forEach((item, index) => {
						item.setAttribute('data-reveal', '');
						item.style.transitionDelay = `${Math.min(index % 6, 5) * 55}ms`;
					});
					const observer = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					}, { threshold: 0.12 });
					revealTargets.forEach((item) => observer.observe(item));
					window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
				}

				if (!isTouch && !reduceQuery.matches) {
					window.addEventListener('pointermove', (event) => {
						if (pointerFrame) return;
						pointerFrame = requestAnimationFrame(() => {
							root.style.setProperty('--pointer-x', `${event.clientX}px`);
							root.style.setProperty('--pointer-y', `${event.clientY}px`);
							pointerFrame = 0;
						});
					}, { passive: true });
					document.addEventListener('visibilitychange', () => {
						if (document.hidden && pointerFrame) {
							cancelAnimationFrame(pointerFrame);
							pointerFrame = 0;
						}
					});
				}

				window.addEventListener('control-room-lang', refreshControls);
				refreshControls();
			})();
		</script>
	</body>
</html>
