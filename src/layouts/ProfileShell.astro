---
import BaseHead from '../components/BaseHead.astro';
import { profile, navItems, socialLinks } from '../data/site';
import entranceSong from '../assets/theme-song/entrance.mp3?url';
import goodbyeSong from '../assets/theme-song/goodbye.mp3?url';

interface Props {
	headTitle: string;
	description: string;
	activeNav: string;
}

const { headTitle, description, activeNav } = Astro.props;
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={headTitle} description={description} />
		<style>
			.shell {
				width: min(1360px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 1.9rem 0 3rem;
				display: grid;
				grid-template-columns: 270px minmax(0, 1fr);
				gap: 1.2rem;
				align-items: start;
			}

			.sidebar,
			.content-panel {
				border: 1px solid var(--line);
				border-radius: 1.5rem;
				background: rgba(12, 16, 24, 0.94);
				box-shadow: 0 24px 44px rgba(0, 0, 0, 0.22);
			}

			.sidebar {
				position: sticky;
				top: 1.3rem;
				padding: 1.25rem;
			}

			.profile-photo {
				display: block;
				width: 112px;
				height: 112px;
				margin: 0 auto;
				border-radius: 1.5rem;
				object-fit: cover;
				object-position: center top;
				border: 1px solid rgba(255, 255, 255, 0.08);
			}

			.profile-name {
				margin-top: 1rem;
				font-size: 2rem;
				text-align: center;
			}

			.profile-role {
				display: inline-flex;
				justify-content: center;
				margin: 0.7rem auto 0;
				padding: 0.38rem 0.9rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.05);
				color: #d7e6f6;
				font-size: 0.82rem;
			}

			.profile-role-wrap {
				display: flex;
				justify-content: center;
			}

			.sidebar-line {
				height: 1px;
				margin: 1.25rem 0;
				background: rgba(255, 255, 255, 0.08);
			}

			.contact-list {
				display: grid;
				gap: 0.9rem;
			}

			.contact-item {
				display: grid;
				grid-template-columns: 44px minmax(0, 1fr);
				gap: 0.75rem;
				align-items: center;
			}

			.contact-icon {
				width: 44px;
				height: 44px;
				border-radius: 0.95rem;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(255, 255, 255, 0.04);
				color: #19c9ff;
			}

			.contact-copy small {
				display: block;
				margin-bottom: 0.18rem;
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-muted);
			}

			.contact-copy a,
			.contact-copy span {
				color: var(--text-strong);
				text-decoration: none;
				font-size: 0.96rem;
			}

			.sidebar-socials {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
			}

			.sidebar-socials a {
				width: 42px;
				height: 42px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border-radius: 0.9rem;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid transparent;
				color: var(--text-strong);
			}

			.sidebar-socials a:hover {
				border-color: rgba(25, 201, 255, 0.28);
				background: rgba(255, 255, 255, 0.06);
			}

			.content-panel {
				overflow: hidden;
			}

			.top-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
				padding: 1rem 1.25rem;
				border-bottom: 1px solid var(--line);
			}

			.top-nav a {
				padding: 0.72rem 1rem;
				border-radius: 0.9rem;
				color: #d0b694;
				text-decoration: none;
				font-size: 0.9rem;
				transition: background-color 180ms ease, color 180ms ease;
			}

			.top-nav a.is-active {
				background: rgba(18, 62, 104, 0.72);
				color: #ffffff;
				font-weight: 700;
			}

			.page-body {
				padding: 1.5rem;
			}

			.lang-float {
				position: fixed;
				top: 16px;
				right: 18px;
				z-index: 80;
				min-width: 58px;
				padding: 0.42rem 0.8rem;
				border-radius: 999px;
				border: 1px solid rgba(255, 255, 255, 0.12);
				background: rgba(14, 18, 26, 0.94);
				color: var(--text-strong);
				font-weight: 700;
				cursor: pointer;
			}

			@media (max-width: 1080px) {
				.shell {
					grid-template-columns: 1fr;
				}

				.sidebar {
					position: static;
				}
			}

			@media (max-width: 720px) {
				.shell {
					width: calc(100% - 1rem);
					padding-top: 1rem;
				}

				.page-body {
					padding: 1rem;
				}

				.top-nav {
					padding: 0.85rem;
				}

				.top-nav a {
					padding: 0.6rem 0.82rem;
					font-size: 0.86rem;
				}
			}
		</style>
	</head>
	<body>
		<button class="lang-float" id="lang-float" type="button">EN</button>
		<main class="shell">
			<aside class="sidebar">
				<img class="profile-photo" src={profile.photo.src} alt={profile.name} />
				<h1 class="profile-name">{profile.name}</h1>
				<div class="profile-role-wrap">
					<span class="profile-role" data-i18n-role>{profile.role}</span>
				</div>

				<div class="sidebar-line"></div>

				<div class="contact-list">
					<div class="contact-item">
						<div class="contact-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11Zm2.2-.5 5.8 5.1L17.8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<div class="contact-copy">
							<small data-i18n="profile.email">Email</small>
