---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-nav" aria-label="Primary">
		<a class="site-brand" href="/">{SITE_TITLE}</a>
		<div class="site-nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#work">Work</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<a class="site-nav-cta" href="/#contact">Contact</a>
	</nav>
</header>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		padding: 1rem 1rem 0;
		background: linear-gradient(180deg, rgba(8, 12, 24, 0.92), rgba(8, 12, 24, 0.72));
		backdrop-filter: blur(18px);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 0.9rem 1rem;
		border: 1px solid rgba(180, 208, 255, 0.14);
		border-radius: 999px;
		background: rgba(8, 12, 24, 0.72);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
	}

	.site-brand {
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-strong);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-nav-links {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.site-nav-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.8rem;
		padding: 0.7rem 1rem;
		border-radius: 999px;
		border: 1px solid rgba(120, 169, 255, 0.35);
		background: linear-gradient(135deg, rgba(110, 166, 255, 0.18), rgba(42, 78, 155, 0.36));
		color: var(--text-strong);
		text-decoration: none;
		font-weight: 600;
		white-space: nowrap;
	}

	.site-nav-cta:hover {
		border-color: rgba(170, 205, 255, 0.55);
		background: linear-gradient(135deg, rgba(110, 166, 255, 0.28), rgba(42, 78, 155, 0.5));
	}

	@media (max-width: 820px) {
		.site-header {
			padding-inline: 0;
		}

		.site-nav {
			width: calc(100% - 1rem);
			border-radius: 1.4rem;
			flex-wrap: wrap;
			justify-content: center;
			padding: 0.85rem;
		}

		.site-brand,
		.site-nav-cta {
			flex: 1 1 auto;
			text-align: center;
		}
	}
</style>
