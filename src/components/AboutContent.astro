---
import { Image } from 'astro:assets';
import { aboutHighlights, profile, serviceCards } from '../data/site';
---

<section class="control-hero">
	<div class="hero-copy">
		<p class="hero-kicker" data-i18n="hero.kicker">MLOps Control Room</p>
		<h2 class="hero-title">NGUYỄN VĂN DUY</h2>
		<p class="hero-role" data-i18n="hero.role">MLOps Engineer</p>
		<p class="hero-subtitle" data-i18n="hero.subtitle">Building the systems behind machine learning.</p>
		<p class="hero-track" data-i18n="hero.track">AI Systems · Cloud Infrastructure · Automation · Research Engineering</p>
		<div class="hero-actions" aria-label="Primary actions">
			<a class="hero-action hero-action-primary" href="/portfolio" data-i18n="hero.cta.projects">View Selected Projects</a>
			<a class="hero-action" href="/resume" data-i18n="hero.cta.resume">View Resume</a>
			<a class="hero-action" href="/contact" data-i18n="hero.cta.contact">Contact Me</a>
		</div>
		<div class="hero-shortcuts" aria-label="Quick links">
			<a href="https://github.com/Dyu20705" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="/cv" data-i18n="hero.shortcut.cv">CV PDF</a>
			<a href="/blog" data-i18n="hero.shortcut.log">Engineering Log</a>
		</div>
	</div>

	<div class="hero-visual" aria-label="MLOps pipeline visual">
		<div class="portrait-node">
			<Image class="hero-photo" src={profile.photo} alt="Ảnh chân dung Nguyễn Văn Duy" data-i18n-alt="profile.photo.alt" width={180} height={180} loading="eager" decoding="async" />
			<span class="node-pulse"></span>
		</div>
		<svg class="pipeline-map" viewBox="0 0 420 260" fill="none" aria-hidden="true">
			<path class="pipeline-line line-a" d="M38 68 H150 C186 68 190 120 226 120 H382" />
			<path class="pipeline-line line-b" d="M38 190 H128 C178 190 178 146 228 146 H382" />
			<path class="pipeline-line line-c" d="M210 34 V226" />
			<g class="pipeline-node"><circle cx="38" cy="68" r="9" /><text x="54" y="73">DATA</text></g>
			<g class="pipeline-node"><circle cx="210" cy="34" r="9" /><text x="226" y="39">TRAIN</text></g>
			<g class="pipeline-node"><circle cx="382" cy="120" r="9" /><text x="274" y="113">REGISTRY</text></g>
			<g class="pipeline-node"><circle cx="382" cy="190" r="9" /><text x="286" y="196">MONITOR</text></g>
			<g class="pipeline-node"><circle cx="210" cy="226" r="9" /><text x="226" y="231">DEPLOY</text></g>
		</svg>
	</div>

	<div class="system-status" aria-label="Current learning track">
		<div class="status-head">
			<span data-i18n="hero.status.title">LEARNING TRACK</span>
			<strong><span class="status-light"></span><span data-i18n="hero.status.online">IN PROGRESS</span></strong>
		</div>
		<dl>
			<div><dt data-i18n="hero.status.focus.label">CURRENT FOCUS</dt><dd data-i18n="hero.status.focus.value">REPRODUCIBLE ML PIPELINES</dd></div>
			<div><dt data-i18n="hero.status.project.label">ACTIVE PROJECT</dt><dd data-i18n="hero.status.project.value">MLOPS PORTFOLIO</dd></div>
			<div><dt data-i18n="hero.status.track.label">ENGINEERING TRACK</dt><dd data-i18n="hero.status.track.value">MLOPS / CLOUD / AI SYSTEMS</dd></div>
			<div><dt data-i18n="hero.status.location.label">LOCATION</dt><dd data-i18n="hero.status.location.value">VIETNAM · UTC+7</dd></div>
		</dl>
	</div>
</section>

<section class="page-section">
	<h2 class="page-title" data-i18n="page.about.title">Về tôi</h2>
	<div class="page-accent"></div>
	<div class="about-copy">
		<p class="about-lead" data-i18n="about.lead">
			Tôi là sinh viên Công nghệ thông tin đang phát triển theo hướng MLOps Engineer, với nền tảng từ
			software, hạ tầng và automation.
		</p>
		<p data-i18n="about.body">
			Tôi học bằng cách xây dựng dự án nhỏ nhưng có cấu trúc: đóng gói môi trường chạy, viết workflow rõ
			ràng, kiểm tra giả định và ghi lại quyết định kỹ thuật. Mục tiêu của tôi là xây dựng các hệ thống ML có
			thể tái lập, triển khai, quan sát và bảo trì thay vì chỉ dừng ở notebook chạy được một lần.
		</p>
	</div>

	<div class="highlight-list">
		{aboutHighlights.map((item, index) => (
			<div class="highlight-item">
				<span class="highlight-dot"></span>
				<p data-i18n={`about.highlight.${index}`}>{item}</p>
			</div>
		))}
	</div>
</section>

<section class="page-section">
	<h3 class="section-heading" data-i18n="about.focus.title">Tôi đang tập trung vào</h3>
	<div class="service-grid">
		{serviceCards.map((card, index) => (
			<article class="service-card">
				<div class="service-icon">
					{
						card.icon === 'pipeline' ? (
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h5v5H4V6Zm11 7h5v5h-5v-5ZM9 8.5h3.5A3.5 3.5 0 0 1 16 12v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="m14 11 2 2 2-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
						) : card.icon === 'infra' ? (
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M7 4v4M12 10v4M17 16v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						) : card.icon === 'deploy' ? (
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M5 10l7-7 7 7M5 14l7 7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
						) : card.icon === 'research' ? (
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 4h4m-2 0v5l5.4 8.8A1.5 1.5 0 0 1 16.1 20H7.9a1.5 1.5 0 0 1-1.3-2.2L12 9V4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.5 16h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						) : (
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h4m8 0h4M12 4v4m0 8v4M7 7l2.5 2.5M14.5 14.5 17 17M17 7l-2.5 2.5M9.5 14.5 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						)
					}
				</div>
				<div>
					<h4 data-i18n={`about.service.${index}.title`}>{card.title}</h4>
					<p data-i18n={`about.service.${index}.body`}>{card.body}</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.control-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.82fr);
		gap: 1.1rem;
		align-items: stretch;
		min-height: 520px;
		padding: clamp(1.2rem, 3vw, 2rem);
		overflow: hidden;
		border: 1px solid rgba(97, 213, 255, 0.22);
		border-radius: 1.25rem;
		background:
			radial-gradient(circle at 78% 18%, rgba(97, 213, 255, 0.18), transparent 22rem),
			linear-gradient(135deg, rgba(7, 16, 30, 0.96), rgba(9, 14, 24, 0.9));
		box-shadow: 0 26px 72px rgba(0, 0, 0, 0.34);
	}

	.control-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(97, 213, 255, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(97, 213, 255, 0.045) 1px, transparent 1px);
		background-size: 36px 36px;
		mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.8), transparent 80%);
		pointer-events: none;
	}

	.hero-copy,
	.hero-visual,
	.system-status {
		position: relative;
		z-index: 1;
	}

	.hero-copy {
		align-self: center;
		display: grid;
		gap: 0.9rem;
		max-width: 720px;
	}

	.hero-kicker,
	.hero-role,
	.hero-track,
	.status-head,
	.system-status dt,
	.system-status dd,
	.pipeline-node text {
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
	}

	.hero-kicker {
		color: #61d5ff;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.78rem;
	}

	.hero-title {
		font-size: clamp(3.2rem, 8vw, 6.8rem);
		letter-spacing: 0;
		line-height: 0.95;
	}

	.hero-role {
		width: fit-content;
		padding: 0.36rem 0.72rem;
		border: 1px solid rgba(97, 213, 255, 0.22);
		border-radius: 999px;
		background: rgba(97, 213, 255, 0.08);
		color: #d8c0a1;
		font-size: 0.88rem;
	}

	.hero-subtitle {
		color: #f3f7fb;
		font-size: clamp(1.35rem, 2.6vw, 2.1rem);
		line-height: 1.25;
		max-width: 15em;
	}

	.hero-track {
		color: #9fb0c2;
		font-size: 0.88rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero-actions,
	.hero-shortcuts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.72rem;
		align-items: center;
	}

	.hero-actions {
		margin-top: 0.35rem;
	}

	.hero-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.72rem 1rem;
		border: 1px solid rgba(97, 213, 255, 0.24);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.04);
		color: #f3f7fb;
		text-decoration: none;
		font-weight: 700;
		transition: transform 160ms ease, border-color 160ms ease, background-color 160ms ease;
	}

	.hero-action:hover,
	.hero-action:focus-visible {
		transform: translateY(-1px);
		border-color: rgba(97, 213, 255, 0.46);
		background: rgba(97, 213, 255, 0.1);
	}

	.hero-action-primary {
		border-color: transparent;
		background: linear-gradient(135deg, #61d5ff, #2d83ff);
		color: #05101b;
		box-shadow: 0 16px 34px rgba(45, 131, 255, 0.26);
	}

	.hero-shortcuts {
		gap: 0.55rem;
	}

	.hero-shortcuts a {
		color: #d8c0a1;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.78rem;
		text-decoration: none;
	}

	.hero-shortcuts a:hover,
	.hero-shortcuts a:focus-visible {
		color: #ffffff;
	}

	.hero-visual {
		min-height: 310px;
		display: grid;
		place-items: center;
	}

	.portrait-node {
		position: relative;
		z-index: 2;
		width: 180px;
		height: 180px;
		border-radius: 2rem;
	}

	.hero-photo {
		width: 180px;
		height: 180px;
		object-fit: cover;
		object-position: center top;
		border-radius: 2rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 22px 50px rgba(0, 0, 0, 0.44);
	}

	.node-pulse {
		position: absolute;
		inset: -14px;
		z-index: -1;
		border: 1px solid rgba(97, 213, 255, 0.32);
		border-radius: 2.5rem;
		animation: hero-pulse 2.8s ease-in-out infinite;
	}

	.pipeline-map {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0.86;
	}

	.pipeline-line {
		stroke: rgba(97, 213, 255, 0.4);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-dasharray: 7 12;
		animation: line-flow 6s linear infinite;
	}

	.line-b {
		stroke: rgba(255, 190, 96, 0.42);
		animation-duration: 7.5s;
	}

	.line-c {
		stroke: rgba(149, 255, 170, 0.28);
		animation-duration: 9s;
	}

	.pipeline-node circle {
		fill: #081321;
		stroke: #61d5ff;
		stroke-width: 2;
	}

	.pipeline-node text {
		fill: #c8d7e8;
		font-size: 10px;
		letter-spacing: 0.08em;
	}

	.system-status {
		grid-column: 1 / -1;
		display: grid;
		gap: 0.9rem;
		align-self: end;
		padding: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 1rem;
		background: rgba(3, 9, 17, 0.62);
	}

	.status-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: #91a0b2;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
	}

	.status-head strong {
		display: inline-flex;
		gap: 0.45rem;
		align-items: center;
		color: #95ffaa;
	}

	.status-light {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: #95ffaa;
		box-shadow: 0 0 0 5px rgba(149, 255, 170, 0.08), 0 0 18px rgba(149, 255, 170, 0.5);
		animation: status-pulse 2.4s ease-in-out infinite;
	}

	.system-status dl {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.7rem;
		margin: 0;
	}

	.system-status div {
		padding: 0.7rem;
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.035);
	}

	.system-status dt {
		color: #74849a;
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.system-status dd {
		margin: 0.2rem 0 0;
		color: #f3f7fb;
		font-size: 0.82rem;
	}

	@keyframes line-flow {
		to {
			stroke-dashoffset: -76;
		}
	}

	@keyframes hero-pulse {
		50% {
			transform: scale(1.035);
			opacity: 0.68;
		}
	}

	@keyframes status-pulse {
		50% {
			opacity: 0.55;
			transform: scale(0.88);
		}
	}

	.page-section + .page-section {
		margin-top: 2rem;
	}

	.page-title {
		font-size: clamp(2.5rem, 4vw, 4rem);
	}

	.page-accent {
		width: 60px;
		height: 4px;
		margin: 1rem 0 1.6rem;
		border-radius: 999px;
		background: #17b8ff;
	}

	.about-copy {
		display: grid;
		gap: 1rem;
		max-width: 58rem;
	}

	.about-lead {
		font-size: 1.34rem;
		line-height: 1.65;
		color: #d8c0a1;
	}

	.about-copy p {
		color: #b6c3d1;
		line-height: 1.9;
		font-size: 1.04rem;
	}

	.highlight-list {
		display: grid;
		gap: 0.8rem;
		margin-top: 1.6rem;
	}

	.highlight-item {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.95rem 1rem;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	.highlight-dot {
		width: 10px;
		height: 10px;
		flex: 0 0 auto;
		margin-top: 0.48rem;
		border-radius: 999px;
		background: #17b8ff;
	}

	.highlight-item p {
		color: #d9e5f1;
	}

	.section-heading {
		font-size: 2rem;
		margin-bottom: 1.25rem;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.service-card {
		display: grid;
		grid-template-columns: 58px minmax(0, 1fr);
		gap: 1rem;
		padding: 1.25rem;
		border-radius: 1.25rem;
		border: 1px solid rgba(216, 190, 154, 0.42);
		background: rgba(255, 255, 255, 0.03);
	}

	.service-icon {
		color: #19c9ff;
	}

	.service-card h4 {
		font-size: 1.3rem;
		margin-bottom: 0.45rem;
	}

	.service-card p {
		color: #b9c6d4;
		line-height: 1.8;
	}

	@media (max-width: 900px) {
		.control-hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.hero-visual {
			min-height: 260px;
		}

		.system-status dl {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.service-grid {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 2.5rem;
		}
	}

	@media (max-width: 560px) {
		.control-hero {
			padding: 1rem;
		}

		.hero-title {
			font-size: clamp(2.65rem, 17vw, 4rem);
		}

		.hero-visual {
			min-height: 220px;
		}

		.portrait-node,
		.hero-photo {
			width: 142px;
			height: 142px;
		}

		.pipeline-node text {
			display: none;
		}

		.hero-actions {
			display: grid;
			grid-template-columns: 1fr;
		}

		.hero-action {
			width: 100%;
		}

		.system-status dl {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pipeline-line,
		.node-pulse,
		.status-light {
			animation: none;
		}
	}
</style>
