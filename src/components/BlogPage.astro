---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Copy from './Copy.astro';
interface Props { posts: CollectionEntry<'blog'>[]; page?: number; pages?: number; }
const { posts, page = 1, pages = 1 } = Astro.props;
---
<SiteLayout activeNav="blog" title={{vi:'Blog | Nguyễn Văn Duy',en:'Blog | Nguyễn Văn Duy'}} description={{vi:'Không gian dành cho ghi chép kỹ thuật và nghiên cứu do Nguyễn Văn Duy tự viết.',en:'A space reserved for engineering and research notes written by Nguyễn Văn Duy.'}}>
  <div class="page-intro"><p class="eyebrow"><Copy vi="Ghi chép" en="Writing" /></p><h1>Blog</h1></div>
  {posts.length ? <div>{posts.map(post => <article class="post-row"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0,10)}</time><h2><a href={`/blog/${post.id}/`}><Copy vi={post.data.title} en={post.data.titleEn || post.data.title} /></a></h2><p><Copy vi={post.data.description} en={post.data.descriptionEn || post.data.description} /></p></article>)}</div> : <section class="empty-blog"><h2><Copy vi="Chưa có bài viết." en="No posts yet." /></h2><p><Copy vi="Không gian này dành cho những ghi chép kỹ thuật và nghiên cứu tôi tự viết." en="This space is reserved for engineering and research notes I write myself." /></p></section>}
  {pages > 1 && <nav class="pagination" aria-label="Pagination">{page > 1 && <a href={page === 2 ? '/blog' : `/blog/page/${page - 1}/`}><Copy vi="← Trước" en="← Previous" /></a>}<span>{page} / {pages}</span>{page < pages && <a href={`/blog/page/${page + 1}/`}><Copy vi="Tiếp →" en="Next →" /></a>}</nav>}
</SiteLayout>
<style>
 .empty-blog { padding-block: 48px 80px; border-top: 1px solid var(--line); max-width: 760px; }
 .empty-blog p { margin-top: 20px; max-width: 560px; }
 .post-row { padding-block: 28px; border-top: 1px solid var(--line); max-width: 820px; }
 .post-row time { color: var(--muted); font-size: .75rem; }
 .post-row h2 { margin: 12px 0; }
</style>
