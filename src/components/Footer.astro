---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<div>
			<p class="footer-kicker">Engineering portfolio</p>
			<p class="footer-copy">
				Built to communicate systems thinking, execution discipline, and a bias toward reliable products.
			</p>
		</div>
		<div class="footer-meta">
			<p>&copy; {today.getFullYear()} Dyu20705</p>
			<p>Deployed on GitHub Pages with Astro.</p>
		</div>
		<div class="footer-links">
			<a href="/">Home</a>
			<a href="/blog">Writing</a>
			<a href="/about">About</a>
			<a href="/#contact">Contact</a>
		</div>
	</div>
</footer>
<style>
	.site-footer {
		padding: 2rem 0 3.5rem;
	}

	.site-footer-inner {
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 1.5rem 1.5rem 0;
		border-top: 1px solid rgba(180, 208, 255, 0.12);
		display: grid;
		grid-template-columns: 1.4fr 0.9fr auto;
		gap: 1rem;
		align-items: start;
		color: var(--text-muted);
	}

	.footer-kicker {
		margin: 0 0 0.35rem;
		font-size: 0.8rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-accent);
	}

	.footer-copy,
	.footer-meta p {
		margin: 0;
		font-size: 0.96rem;
		line-height: 1.65;
	}

	.footer-meta {
		display: grid;
		gap: 0.35rem;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.8rem;
	}

	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--text-strong);
	}

	@media (max-width: 820px) {
		.site-footer-inner {
			grid-template-columns: 1fr;
		}

		.footer-links {
			justify-content: flex-start;
		}
	}
</style>
