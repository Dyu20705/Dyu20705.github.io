---
import { profile, socialLinks } from '../data/site';
import Copy from './Copy.astro';
---
<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-contact">
      <div class="email-line"><a class="email-address" href={`mailto:${profile.email}`}>{profile.email}</a><button class="copy-email" type="button" data-copy-email={profile.email} data-ui-aria="copy" aria-label="Sao chép email" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 8V4H4v12h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></button></div>
      <p class="muted"><Copy {...profile.location} /></p>
      <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
    </div>
    <div class="footer-right"><div class="social-links">{socialLinks.map(link => <a href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>)}</div><p class="copyright">© {new Date().getFullYear()} {profile.name}</p></div>
  </div>
</footer>
