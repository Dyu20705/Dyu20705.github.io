---
import '../styles/global.css';
import BrowserIcon from '../assets/img/image.png';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
interface Props { title: string; titleEn?: string; description: string; descriptionEn?: string; noindex?: boolean; }
const { title, titleEn = title, description, descriptionEn = description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL('/readme-preview.svg', Astro.site);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Nguyễn Văn Duy',
  url: Astro.site?.toString(), jobTitle: 'Computer Science Student',
  sameAs: ['https://github.com/Dyu20705', 'https://www.linkedin.com/in/duynguyenvan05/'],
  knowsAbout: ['ML Systems', 'MLOps', 'ML Infrastructure', 'Platform Engineering'],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#121315" />
<meta name="format-detection" content="telephone=no, email=no, address=no" />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
<link rel="icon" type="image/png" href={BrowserIcon.src} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<Font cssVariable="--font-atkinson" preload />
<link rel="canonical" href={canonicalURL} />
<title data-meta-vi={title} data-meta-en={titleEn}>{title}</title>
<meta name="description" content={description} data-meta-vi={description} data-meta-en={descriptionEn} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Nguyễn Văn Duy — Computer Science Student" />
<meta property="og:locale" content="vi_VN" />
<meta property="og:locale:alternate" content="en_US" />
<meta property="og:title" content={title} data-meta-vi={title} data-meta-en={titleEn} />
<meta property="og:description" content={description} data-meta-vi={description} data-meta-en={descriptionEn} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content="Nguyễn Văn Duy — Computer Science Student" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} data-meta-vi={title} data-meta-en={titleEn} />
<meta name="twitter:description" content={description} data-meta-vi={description} data-meta-en={descriptionEn} />
<meta name="twitter:image" content={imageURL} />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
